+
+    it('404 ALERT_NOT_FOUND for an unknown alert', async () => {
+      const { w, incident } = await setup();
+      const res = await request(app).get(url(incident.id, randomUUID())).set(w.auth.engA);
+      expect(res.status).toBe(404);
