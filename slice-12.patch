+import { parseEvaluationOutput } from './evaluation.output';
+
+const A = '0192b5e0-7c1a-7d2e-8f3b-4a5c6d7e8f01';
+const B = '0192b5e0-7c1a-7d2e-8f3b-4a5c6d7e8f02';
+const sent = new Set([A]);
+
+const parse = (value: unknown, ids = sent) => parseEvaluationOutput(JSON.stringify(value), ids);
+const valid = () => ({
+  patterns: [{ text: 'Pool exhaustion recurs', label: 'INFERENCE', evidenceIds: [A] }],
+  limitations: null,
+});
+
+describe('parseEvaluationOutput', () => {
+  it('accepts a structured output whose patterns cite sent evidence', () => {
+    const result = parse(valid());
+    expect(result.ok && result.value.patterns).toHaveLength(1);
+  });
+
+  it('accepts no patterns at all', () => {
+    expect(parse({ patterns: [], limitations: 'Too little evidence.' }).ok).toBe(true);
+  });
+
+  it('rejects non-JSON text and a missing structure', () => {
+    expect(parseEvaluationOutput('nope', sent).ok).toBe(false);
+    expect(parse({ limitations: null }).ok).toBe(false);
+  });
+
+  it('rejects a pattern citing evidence that was not sent, or citing nothing', () => {
+    const unsupported = valid();
+    unsupported.patterns[0].evidenceIds = [B];
+    expect(parse(unsupported).ok).toBe(false);
+    const none = valid();
+    none.patterns[0].evidenceIds = [];
+    expect(parse(none).ok).toBe(false);
+  });
+
+  it('rejects an unlabelled pattern or an unknown label', () => {
+    const missing = valid() as { patterns: Record<string, unknown>[] };
+    delete missing.patterns[0].label;
+    expect(parse(missing).ok).toBe(false);
+    const wrong = valid();
+    wrong.patterns[0].label = 'GUESS';
+    expect(parse(wrong).ok).toBe(false);
+  });
+});
diff --git a/backend/src/modules/ai/evaluation/evaluation.output.ts b/backend/src/modules/ai/evaluation/evaluation.output.ts
new file mode 100644
index 0000000..06fffe8
--- /dev/null
+++ b/backend/src/modules/ai/evaluation/evaluation.output.ts
@@ -0,0 +1,61 @@
+import { z } from 'zod';
+
+export const PATTERN_LABELS = ['FACTUAL', 'INFERENCE', 'UNKNOWN'] as const;
+
+/** Bounds of a valid evaluation output (owner-approved with SLICE-12 §4.6). */
+export const EVALUATION_LIMITS = {
+  patternsMax: 30,
+  textMax: 1000,
+  evidenceIdsPerPatternMax: 50,
+  limitationsMax: 1000,
+} as const;
+
+const boundedText = (max: number) => z.string().trim().min(1).max(max);
+
+/** A pattern's origin is the evidence it cites. Keys the model adds are dropped. */
+const outputSchema = z.object({
+  patterns: z
+    .array(
+      z.object({
+        text: boundedText(EVALUATION_LIMITS.textMax),
+        label: z.enum(PATTERN_LABELS),
+        evidenceIds: z.array(z.uuid()).min(1).max(EVALUATION_LIMITS.evidenceIdsPerPatternMax),
+      }),
+    )
+    .max(EVALUATION_LIMITS.patternsMax),
+  limitations: boundedText(EVALUATION_LIMITS.limitationsMax).nullable(),
+});
+
+export type EvaluationResult = z.infer<typeof outputSchema>;
+
+export type ParsedEvaluationOutput =
+  { ok: true; value: EvaluationResult } | { ok: false; fields: string[] };
+
+/**
+ * Validates the model's text before anything is stored (SLICE-12 §4.6): structured, every pattern
+ * labelled, and every cited id one of the evidence ids that were sent. Anything else is rejected.
+ */
+export function parseEvaluationOutput(
+  text: string,
+  sentEvidenceIds: ReadonlySet<string>,
+): ParsedEvaluationOutput {
+  let raw: unknown;
+  try {
+    raw = JSON.parse(text.trim());
+  } catch {
+    return { ok: false, fields: ['*'] };
+  }
+  const result = outputSchema.safeParse(raw);
+  if (!result.success) {
+    return {
+      ok: false,
+      fields: [...new Set(result.error.issues.map((issue) => issue.path.join('.') || '*'))],
+    };
+  }
+  for (const pattern of result.data.patterns) {
+    if (pattern.evidenceIds.some((id) => !sentEvidenceIds.has(id))) {
+      return { ok: false, fields: ['patterns.evidenceIds'] };
+    }
+  }
+  return { ok: true, value: result.data };
+}
