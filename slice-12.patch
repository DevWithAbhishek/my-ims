@@ -0,0 +1,116 @@
+import type { EvidenceCandidate } from './investigation.candidates';
+import { parseInvestigationOutput } from './investigation.output';
+
+const A = '0192b5e0-7c1a-7d2e-8f3b-4a5c6d7e8f01';
+const B = '0192b5e0-7c1a-7d2e-8f3b-4a5c6d7e8f02';
+const UNKNOWN_ID = '0192b5e0-7c1a-7d2e-8f3b-4a5c6d7e8f99';
+
+const candidates: EvidenceCandidate[] = [
+  { id: A, sourceType: 'INCIDENT', sourceReference: 'inc-1', incidentId: 'inc-1', fields: {} },
+  { id: B, sourceType: 'POSTMORTEM', sourceReference: 'inc-2', incidentId: 'inc-2', fields: {} },
+];
+
+const valid = () => ({
+  evidence: [
+    { id: A, evidenceType: 'FACT', sourceType: 'INCIDENT', relevance: 'the incident' },
+    { id: B, evidenceType: 'INFERENCE', sourceType: 'POSTMORTEM', relevance: 'similar cause' },
+  ],
+  brief: {
+    summary: 'Looks like the database.',
+    findings: [{ text: 'The DB is down.', evidenceIds: [A] }],
+    possibleAreas: [{ text: 'Connection pool', evidenceIds: [B] }],
+    suggestedSteps: [{ text: 'Check the pool' }],
+    limitations: null,
+  },
+});
+
+const parse = (value: unknown) => parseInvestigationOutput(JSON.stringify(value), candidates);
+
+describe('parseInvestigationOutput', () => {
+  it('accepts a valid output and takes the origin from the candidates', () => {
+    const result = parse(valid());
+    expect(result.ok).toBe(true);
+    if (!result.ok) return;
+    expect(result.evidence).toEqual([
+      expect.objectContaining({ id: A, sourceType: 'INCIDENT', sourceReference: 'inc-1' }),
+      expect.objectContaining({ id: B, sourceType: 'POSTMORTEM', sourceReference: 'inc-2' }),
+    ]);
+    expect(result.brief.findings).toHaveLength(1);
+  });
+
+  it('drops keys the model adds', () => {
+    const output = { ...valid(), extra: 1 };
+    output.brief = { ...output.brief, chainOfThought: 'x' } as typeof output.brief;
+    const result = parse(output);
+    expect(result.ok && Object.keys(result.brief)).not.toContain('chainOfThought');
+  });
+
+  it('rejects text that is not JSON', () => {
+    expect(parseInvestigationOutput('not json', candidates)).toEqual({ ok: false, fields: ['*'] });
+  });
+
+  it('rejects an evidence id that is not a candidate, and a repeated one', () => {
+    const unknown = valid();
+    unknown.evidence[1].id = UNKNOWN_ID;
+    expect(parse(unknown).ok).toBe(false);
+    const repeated = valid();
+    repeated.evidence[1].id = A;
+    expect(parse(repeated).ok).toBe(false);
+  });
+
+  it('requires at least one evidence record', () => {
+    const output = valid();
+    output.evidence = [];
+    expect(parse(output).ok).toBe(false);
+  });
+
+  it('rejects a missing or mismatching origin type', () => {
+    const wrong = valid();
+    wrong.evidence[0].sourceType = 'POSTMORTEM';
+    expect(parse(wrong).ok).toBe(false);
+    const missing = valid() as { evidence: Record<string, unknown>[] };
+    delete missing.evidence[0].sourceType;
+    expect(parse(missing).ok).toBe(false);
+  });
+
+  it('requires every finding to cite a FACT evidence id', () => {
+    const output = valid();
+    output.brief.findings = [{ text: 'Guess', evidenceIds: [B] }];
+    expect(parse(output).ok).toBe(false);
+    output.brief.findings = [{ text: 'Mixed', evidenceIds: [B, A] }];
+    expect(parse(output).ok).toBe(true);
+  });
+
+  it('rejects a finding or area that cites an id outside the evidence list, or cites none', () => {
+    const finding = valid();
+    finding.brief.findings = [{ text: 'x', evidenceIds: [UNKNOWN_ID] }];
+    expect(parse(finding).ok).toBe(false);
+    const area = valid();
+    area.brief.possibleAreas = [{ text: 'x', evidenceIds: [UNKNOWN_ID] }];
+    expect(parse(area).ok).toBe(false);
+    const none = valid();
+    none.brief.possibleAreas = [{ text: 'x', evidenceIds: [] }];
+    expect(parse(none).ok).toBe(false);
+  });
+
+  it('rejects blank texts, a missing relevance and an invalid evidence type', () => {
+    const blank = valid();
+    blank.brief.summary = '   ';
+    expect(parse(blank).ok).toBe(false);
+    const relevance = valid() as { evidence: Record<string, unknown>[] };
+    delete relevance.evidence[0].relevance;
+    expect(parse(relevance).ok).toBe(false);
+    const type = valid();
+    type.evidence[0].evidenceType = 'GUESS';
+    expect(parse(type).ok).toBe(false);
+  });
+
+  it('allows empty findings, areas and steps and a limitations text', () => {
+    const output = valid();
+    output.brief.findings = [];
+    output.brief.possibleAreas = [];
+    output.brief.suggestedSteps = [];
+    (output.brief as { limitations: string | null }).limitations = 'Little history.';
+    expect(parse(output).ok).toBe(true);
+  });
+});
diff --git a/backend/src/modules/ai/investigation/investigation.output.ts b/backend/src/modules/ai/investigation/investigation.output.ts
new file mode 100644
index 0000000..c8f505f
--- /dev/null
+++ b/backend/src/modules/ai/investigation/investigation.output.ts
@@ -0,0 +1,113 @@
+import { z } from 'zod';
+import type { EvidenceCandidate, SourceType } from './investigation.candidates.js';
+import { EVIDENCE_TYPES, INVESTIGATION_LIMITS, SOURCE_TYPES } from './investigation.limits.js';
+
+const boundedText = (max: number) => z.string().trim().min(1).max(max);
+
+const evidenceIds = z.array(z.uuid()).min(1).max(INVESTIGATION_LIMITS.evidenceIdsPerItemMax);
+
+const citedItem = z.object({
+  text: boundedText(INVESTIGATION_LIMITS.itemTextMax),
+  evidenceIds,
+});
+
+const briefSchema = z.object({
+  summary: boundedText(INVESTIGATION_LIMITS.summaryMax),
+  findings: z.array(citedItem).max(INVESTIGATION_LIMITS.findingsMax),
+  possibleAreas: z.array(citedItem).max(INVESTIGATION_LIMITS.possibleAreasMax),
+  suggestedSteps: z
+    .array(z.object({ text: boundedText(INVESTIGATION_LIMITS.itemTextMax) }))
+    .max(INVESTIGATION_LIMITS.suggestedStepsMax),
+  limitations: boundedText(INVESTIGATION_LIMITS.limitationsMax).nullable(),
+});
+
+/** Keys the model adds beyond these are dropped, so what is stored is exactly the validated form. */
+const outputSchema = z.object({
+  evidence: z
+    .array(
+      z.object({
+        id: z.uuid(),
+        evidenceType: z.enum(EVIDENCE_TYPES),
+        sourceType: z.enum(SOURCE_TYPES),
+        relevance: boundedText(INVESTIGATION_LIMITS.relevanceMax),
+      }),
+    )
+    .min(1),
+  brief: briefSchema,
+});
+
+export type InvestigationBrief = z.infer<typeof briefSchema>;
+
+/** One evidence record to store: the model's judgement plus the origin taken from the candidate. */
+export type ValidatedEvidence = {
+  id: string;
+  evidenceType: (typeof EVIDENCE_TYPES)[number];
+  sourceType: SourceType;
+  sourceReference: string;
+  incidentId: string;
+  relevance: string;
+};
+
+export type ParsedInvestigationOutput =
+  | { ok: true; evidence: ValidatedEvidence[]; brief: InvestigationBrief }
+  | {
+      ok: false;
+      /** Paths of the failing fields (never values), safe to log. */
+      fields: string[];
+    };
+
+const fail = (...fields: string[]): ParsedInvestigationOutput => ({ ok: false, fields });
+
+/**
+ * Parses and validates the model's text against the candidates it was given (SLICE-12 §4.3 step 5).
+ * Any violation makes the whole output invalid: unknown or repeated evidence ids, an origin that
+ * does not match the candidate, a finding without a `FACT` among its evidence, a citation of an id
+ * that is not in the evidence list.
+ */
+export function parseInvestigationOutput(
+  text: string,
+  candidates: readonly EvidenceCandidate[],
+): ParsedInvestigationOutput {
+  let raw: unknown;
+  try {
+    raw = JSON.parse(text.trim());
+  } catch {
+    return fail('*');
+  }
+  const result = outputSchema.safeParse(raw);
+  if (!result.success) {
+    return fail(...new Set(result.error.issues.map((issue) => issue.path.join('.') || '*')));
+  }
+
+  const byId = new Map(candidates.map((candidate) => [candidate.id, candidate]));
+  const listed = new Map<string, ValidatedEvidence>();
+  for (const item of result.data.evidence) {
+    const candidate = byId.get(item.id);
+    if (!candidate) return fail('evidence.id');
+    if (listed.has(item.id)) return fail('evidence.id');
+    if (item.sourceType !== candidate.sourceType) return fail('evidence.sourceType');
+    listed.set(item.id, {
+      id: item.id,
+      evidenceType: item.evidenceType,
+      sourceType: candidate.sourceType,
+      sourceReference: candidate.sourceReference,
+      incidentId: candidate.incidentId,
+      relevance: item.relevance,
+    });
+  }
+
+  const { brief } = result.data;
+  for (const finding of brief.findings) {
+    const cited = finding.evidenceIds.map((id) => listed.get(id));
+    if (cited.some((entry) => entry === undefined)) return fail('brief.findings.evidenceIds');
+    if (!cited.some((entry) => entry?.evidenceType === 'FACT')) {
+      return fail('brief.findings.evidenceIds');
+    }
+  }
+  for (const area of brief.possibleAreas) {
+    if (area.evidenceIds.some((id) => !listed.has(id)))
+      return fail('brief.possibleAreas.evidenceIds');
+  }
+
+  return { ok: true, evidence: [...listed.values()], brief };
+}
diff --git a/backend/src/modules/ai/investigation/investigation.processor.ts b/backend/src/modules/ai/investigation/investigation.processor.ts
