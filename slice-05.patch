+++ b/backend/src/modules/incidents/update/lifecycle-rows.spec.ts
@@ -0,0 +1,52 @@
+import { AppError } from '../../../shared/errors/AppError.js';
+import { parseOrThrow } from '../../../shared/errors/zod.js';
+import { selectRow } from './incident-update.dispatcher.js';
+import { updateIncidentBodySchema } from './incident-update.schema.js';
+
+const USER = '0198c3a0-7c1e-7a45-8a40-1f2f3a4b5c6d';
+const rowOf = (body: unknown) => selectRow(parseOrThrow(updateIncidentBodySchema, body)).id;
+const failure = (body: unknown) => {
+  try {
+    rowOf(body);
+  } catch (error) {
+    const { statusCode, code } = error as AppError;
+    return { statusCode, code };
+  }
+  throw new Error('matched a row');
+};
+
+describe('exactly-one-row matching of the lifecycle actions', () => {
+  it.each([
+    ['I3', { status: 'ACKNOWLEDGED' }],
+    ['I4', { status: 'MITIGATING', severity: 'P1' }],
+    ['I5', { severity: 'P2' }],
+    ['I6', { currentAssignee: USER }],
+    ['I7', { currentAssignee: null, status: 'OPEN' }],
+    ['I8', { status: 'RESOLVED', resolutionSummary: 'fixed', serviceConfirmedWorking: true }],
+    ['I10', { comment: { body: 'hi' } }],
+  ])('%s matches its documented body', (id, body) => {
+    expect(rowOf(body)).toBe(id);
+  });
+
+  it('routes an incomplete or false I8 body to the resolve row (its handler answers 422 / 400)', () => {
+    expect(rowOf({ status: 'RESOLVED' })).toBe('I8');
+    expect(
+      rowOf({ status: 'RESOLVED', resolutionSummary: 'x', serviceConfirmedWorking: false }),
+    ).toBe('I8');
+  });
+
+  it.each([
+    ['an empty body', {}],
+    ['status OPEN alone', { status: 'OPEN' }],
+    ['status MITIGATING without severity', { status: 'MITIGATING' }],
+    ['status ACKNOWLEDGED with severity', { status: 'ACKNOWLEDGED', severity: 'P1' }],
+    ['an assignee with a status', { currentAssignee: USER, status: 'OPEN' }],
+    ['an assignee with a severity', { currentAssignee: USER, severity: 'P1' }],
+    ['a null assignee with ACKNOWLEDGED', { currentAssignee: null, status: 'ACKNOWLEDGED' }],
+    ['a severity next to a resolve', { status: 'RESOLVED', severity: 'P1' }],
+    ['a resolution summary without status', { resolutionSummary: 'x' }],
+    ['a comment next to an action', { comment: { body: 'x' }, status: 'ACKNOWLEDGED' }],
+  ])('%s matches no row: 422', (_name, body) => {
+    expect(failure(body)).toEqual({ statusCode: 422, code: 'VALIDATION_FAILED' });
+  });
+});
diff --git a/backend/src/modules/incidents/update/lifecycle-rows.ts b/backend/src/modules/incidents/update/lifecycle-rows.ts
new file mode 100644
index 0000000..9650427
--- /dev/null
+++ b/backend/src/modules/incidents/update/lifecycle-rows.ts
@@ -0,0 +1,108 @@
+import {
+  acknowledgeIncident,
+  assignIncident,
+  changeSeverity,
+  confirmSeverity,
+  resolveIncident,
+  unassignIncident,
+} from '../lifecycle/lifecycle.service.js';
+import type { UpdateRow } from './incident-update.dispatcher.js';
+
+const only =
+  (...names: string[]) =>
+  (fields: string[]) =>
+    fields.length === names.length && names.every((name) => fields.includes(name));
+
+const respond = (data: unknown) => ({ status: 200, data });
+
+/** I3: exactly `{ status: ACKNOWLEDGED }`. */
+const acknowledgeRow: UpdateRow = {
+  id: 'I3',
+  matches: (fields, body) => only('status')(fields) && body.status === 'ACKNOWLEDGED',
+  handle: async ({ auth, incidentId, requestId }) =>
+    respond(await acknowledgeIncident(auth, incidentId, requestId)),
+};
+
+/** I4: exactly `{ status: MITIGATING, severity }`. */
+const confirmSeverityRow: UpdateRow = {
+  id: 'I4',
+  matches: (fields, body) => only('status', 'severity')(fields) && body.status === 'MITIGATING',
+  handle: async ({ auth, incidentId, body, requestId }) =>
+    respond(
+      await confirmSeverity(
+        auth,
+        incidentId,
+        body.severity as NonNullable<typeof body.severity>,
+        requestId,
+      ),
+    ),
+};
+
+/** I5: exactly `{ severity }`. */
+const changeSeverityRow: UpdateRow = {
+  id: 'I5',
+  matches: only('severity'),
+  handle: async ({ auth, incidentId, body, requestId }) =>
+    respond(
+      await changeSeverity(
+        auth,
+        incidentId,
+        body.severity as NonNullable<typeof body.severity>,
+        requestId,
+      ),
+    ),
+};
+
+/** I6: exactly `{ currentAssignee: <uuid> }`. */
+const assignRow: UpdateRow = {
+  id: 'I6',
+  matches: (fields, body) => only('currentAssignee')(fields) && body.currentAssignee !== null,
+  handle: async ({ auth, incidentId, body, requestId }) =>
+    respond(await assignIncident(auth, incidentId, body.currentAssignee as string, requestId)),
+};
+
+/** I7: exactly `{ currentAssignee: null, status: OPEN }`. */
+const unassignRow: UpdateRow = {
+  id: 'I7',
+  matches: (fields, body) =>
+    only('currentAssignee', 'status')(fields) &&
+    body.currentAssignee === null &&
+    body.status === 'OPEN',
+  handle: async ({ auth, incidentId, requestId }) =>
+    respond(await unassignIncident(auth, incidentId, requestId)),
+};
+
+/**
+ * I8: `status: RESOLVED` with `resolutionSummary` and `serviceConfirmedWorking` and nothing else.
+ * Matching only needs the status; a missing summary is `422` and a flag other than `true` is
+ * `400`, decided after the team gate.
+ */
+const resolveRow: UpdateRow = {
+  id: 'I8',
+  matches: (fields, body) =>
+    body.status === 'RESOLVED' &&
+    fields.every((field) =>
+      ['status', 'resolutionSummary', 'serviceConfirmedWorking'].includes(field),
+    ),
+  handle: async ({ auth, incidentId, body, requestId }) =>
+    respond(
+      await resolveIncident(
+        auth,
+        incidentId,
+        {
+          resolutionSummary: body.resolutionSummary,
+          serviceConfirmedWorking: body.serviceConfirmedWorking,
+        },
+        requestId,
+      ),
+    ),
+};
+
+export const LIFECYCLE_ROWS: readonly UpdateRow[] = [
+  acknowledgeRow,
+  confirmSeverityRow,
+  changeSeverityRow,
+  assignRow,
+  unassignRow,
+  resolveRow,
+];
