+/**
+ * How long a lifecycle transition waits for the incident row lock before it gives up with
+ * `409 CONCURRENCY_CONFLICT`. Kept below Prisma's 5 s interactive-transaction timeout, so the
+ * lock timeout fires first and the transaction is not aborted for exceeding its own limit.
+ */
+export const INCIDENT_LOCK_TIMEOUT_MS = 2_000;
diff --git a/backend/src/modules/incidents/lifecycle/lifecycle.plans.spec.ts b/backend/src/modules/incidents/lifecycle/lifecycle.plans.spec.ts
new file mode 100644
index 0000000..1a9ed1f
--- /dev/null
+++ b/backend/src/modules/incidents/lifecycle/lifecycle.plans.spec.ts
@@ -0,0 +1,266 @@
+import type { AppError } from '../../../shared/errors/AppError.js';
+import type { AuthContext } from '../../../shared/types/auth-context.js';
+import {
+  planAcknowledge,
+  planAssign,
+  planChangeSeverity,
+  planConfirmSeverity,
+  planResolve,
+  planUnassign,
+} from './lifecycle.plans.js';
+import type { LockedIncident } from './lifecycle.types.js';
+
+const NOW = new Date('2026-10-15T10:00:00.000Z');
+const incident = (overrides: Partial<LockedIncident> = {}): LockedIncident => ({
+  id: 'i1',
+  teamId: 't1',
+  affectedServiceId: 's1',
+  status: 'OPEN',
+  severity: 'P2',
+  currentAssigneeId: null,
+  acknowledgedById: null,
+  ...overrides,
+});
+const auth = (role: AuthContext['role'] = 'TEAM_LEAD', userId = 'caller'): AuthContext => ({
+  userId,
+  email: 'a@example.com',
+  role,
+  teamId: 't1',
+  sessionId: 's',
+});
+const events = (plan: { events: { eventType: string }[] }) => plan.events.map((e) => e.eventType);
+const failure = (fn: () => unknown) => {
+  try {
+    fn();
+  } catch (error) {
+    const { statusCode, code } = error as AppError;
+    return { statusCode, code };
+  }
+  throw new Error('did not throw');
+};
+
+describe('planAcknowledge (I3)', () => {
+  it('auto-assigns an unassigned incident: ASSIGNED then ACKNOWLEDGED', () => {
+    const plan = planAcknowledge(incident(), 'caller', NOW);
+    expect(plan.changes).toEqual({
+      status: 'ACKNOWLEDGED',
+      acknowledgedById: 'caller',
+      acknowledgedTimestamp: NOW,
+      currentAssigneeId: 'caller',
+    });
+    expect(plan.events).toEqual([
+      {
+        eventType: 'ASSIGNED',
+        metadata: { from: null, to: 'caller', auto: true },
+        subjectUserId: 'caller',
+      },
+      {
+        eventType: 'ACKNOWLEDGED',
+        metadata: { acknowledgedBy: 'caller', autoAssigned: true },
+        subjectUserId: 'caller',
+      },
+    ]);
+    expect(plan.outbox).toEqual([]);
+  });
+
+  it('keeps the assignee of an assigned incident and writes only ACKNOWLEDGED', () => {
+    const plan = planAcknowledge(incident({ currentAssigneeId: 'other' }), 'caller', NOW);
+    expect(plan.changes).not.toHaveProperty('currentAssigneeId');
+    expect(events(plan)).toEqual(['ACKNOWLEDGED']);
+    expect(plan.events[0].metadata).toEqual({ acknowledgedBy: 'caller', autoAssigned: false });
+  });
+
+  it.each(['ACKNOWLEDGED', 'MITIGATING', 'RESOLVED', 'CLOSED'] as const)('%s → 409', (status) => {
+    expect(failure(() => planAcknowledge(incident({ status }), 'caller', NOW))).toEqual({
+      statusCode: 409,
+      code: 'INVALID_STATE_TRANSITION',
+    });
+  });
+});
+
+describe('planConfirmSeverity (I4)', () => {
+  it('moves ACKNOWLEDGED to MITIGATING and requests an SLA evaluation', () => {
+    const plan = planConfirmSeverity(incident({ status: 'ACKNOWLEDGED' }), 'P0', 'caller', NOW);
+    expect(plan.changes).toEqual({
+      severity: 'P0',
+      severityConfirmedById: 'caller',
+      severityConfirmTimestamp: NOW,
+      status: 'MITIGATING',
+    });
+    expect(plan.events[0]).toEqual({
+      eventType: 'SEVERITY_CONFIRMED',
+      metadata: { from: 'P2', to: 'P0', statusFrom: 'ACKNOWLEDGED', statusTo: 'MITIGATING' },
+    });
+    expect(plan.outbox).toEqual([
+      {
+        eventType: 'SLA_EVALUATION_REQUESTED',
+        aggregateType: 'INCIDENT',
+        aggregateId: 'i1',
+        payload: { incidentId: 'i1' },
+      },
+    ]);
+  });
+
+  it('writes the event even when the severity is confirmed unchanged', () => {
+    const plan = planConfirmSeverity(incident({ status: 'ACKNOWLEDGED' }), 'P2', 'caller', NOW);
+    expect(plan.events[0].metadata).toMatchObject({ from: 'P2', to: 'P2' });
+  });
+
+  it.each(['OPEN', 'MITIGATING', 'RESOLVED', 'CLOSED'] as const)('%s → 409', (status) => {
+    expect(failure(() => planConfirmSeverity(incident({ status }), 'P1', 'caller', NOW))).toEqual({
+      statusCode: 409,
+      code: 'INVALID_STATE_TRANSITION',
+    });
+  });
+});
+
+describe('planChangeSeverity (I5)', () => {
+  it('changes the severity and keeps the status in the event', () => {
+    const plan = planChangeSeverity(incident({ status: 'MITIGATING' }), 'P0', auth());
+    expect(plan.changes).toEqual({ severity: 'P0' });
+    expect(plan.events[0].metadata).toEqual({
+      from: 'P2',
+      to: 'P0',
+      statusFrom: 'MITIGATING',
+      statusTo: 'MITIGATING',
+    });
+    expect(plan.outbox).toHaveLength(1);
+  });
+
+  it('is a complete no-op for the same value', () => {
+    expect(planChangeSeverity(incident({ status: 'OPEN' }), 'P2', auth())).toEqual({
+      changes: {},
+      events: [],
+      outbox: [],
+    });
+  });
+
+  it('refuses an Engineer on an OPEN incident but not once acknowledged', () => {
+    expect(failure(() => planChangeSeverity(incident(), 'P0', auth('ENGINEER')))).toEqual({
+      statusCode: 403,
+      code: 'FORBIDDEN_ROLE',
+    });
+    expect(() =>
+      planChangeSeverity(incident({ status: 'ACKNOWLEDGED' }), 'P0', auth('ENGINEER')),
+    ).not.toThrow();
+  });
+
+  it.each(['RESOLVED', 'CLOSED'] as const)('%s → 409 (before the role rule)', (status) => {
+    expect(failure(() => planChangeSeverity(incident({ status }), 'P0', auth('ENGINEER')))).toEqual(
+      {
+        statusCode: 409,
+        code: 'INVALID_STATE_TRANSITION',
+      },
+    );
+  });
+});
+
+describe('planAssign (I6)', () => {
+  it('first assignment: ASSIGNED { from: null, auto: false }', () => {
+    const plan = planAssign(incident(), 'b');
+    expect(plan.changes).toEqual({ currentAssigneeId: 'b' });
+    expect(plan.events).toEqual([
+      {
+        eventType: 'ASSIGNED',
+        metadata: { from: null, to: 'b', auto: false },
+        subjectUserId: 'b',
+      },
+    ]);
+  });
+
+  it('reassignment: REASSIGNED { from, to }', () => {
+    const plan = planAssign(incident({ currentAssigneeId: 'a' }), 'b');
+    expect(plan.events).toEqual([
+      { eventType: 'REASSIGNED', metadata: { from: 'a', to: 'b' }, subjectUserId: 'b' },
+    ]);
+  });
+
+  it('never touches the acknowledgement or the status', () => {
+    const { changes } = planAssign(
+      incident({ status: 'ACKNOWLEDGED', currentAssigneeId: 'a' }),
+      'b',
+    );
+    expect(Object.keys(changes)).toEqual(['currentAssigneeId']);
+  });
+
+  it('the current assignee again is a no-op', () => {
+    expect(planAssign(incident({ currentAssigneeId: 'a' }), 'a').events).toEqual([]);
+  });
+
+  it.each(['RESOLVED', 'CLOSED'] as const)('%s → 409', (status) => {
+    expect(failure(() => planAssign(incident({ status }), 'b')).statusCode).toBe(409);
+  });
+});
+
+describe('planUnassign (I7)', () => {
+  it('assigned and acknowledged: REASSIGNED then OPEN, acknowledgement cleared, SLA evaluation', () => {
+    const plan = planUnassign(
+      incident({ status: 'MITIGATING', currentAssigneeId: 'a', acknowledgedById: 'a' }),
+    );
+    expect(plan.changes).toEqual({
+      currentAssigneeId: null,
+      status: 'OPEN',
+      acknowledgedById: null,
+      acknowledgedTimestamp: null,
+    });
+    expect(plan.events).toEqual([
+      { eventType: 'REASSIGNED', metadata: { from: 'a', to: null }, subjectUserId: 'a' },
+      { eventType: 'OPEN', metadata: { statusFrom: 'MITIGATING' } },
+    ]);
+    expect(plan.outbox).toHaveLength(1);
+  });
+
+  it('assigned but still OPEN: only REASSIGNED, no SLA evaluation', () => {
+    const plan = planUnassign(incident({ currentAssigneeId: 'a' }));
+    expect(events(plan)).toEqual(['REASSIGNED']);
+    expect(plan.outbox).toEqual([]);
+  });
+
+  it('unassigned but acknowledged: only OPEN', () => {
+    const plan = planUnassign(incident({ status: 'ACKNOWLEDGED' }));
+    expect(events(plan)).toEqual(['OPEN']);
+    expect(plan.outbox).toHaveLength(1);
+  });
+
+  it('already unassigned and OPEN: nothing', () => {
+    expect(planUnassign(incident())).toEqual({ changes: {}, events: [], outbox: [] });
+  });
+
+  it.each(['RESOLVED', 'CLOSED'] as const)('%s → 409', (status) => {
+    expect(failure(() => planUnassign(incident({ status }))).statusCode).toBe(409);
+  });
+});
+
+describe('planResolve (I8)', () => {
+  const mitigating = incident({ status: 'MITIGATING', currentAssigneeId: 'caller' });
+
+  it('resolves and writes RESOLVED with the summary', () => {
+    const plan = planResolve(mitigating, auth('ENGINEER'), 'rolled back', NOW);
+    expect(plan.changes).toEqual({
+      status: 'RESOLVED',
+      resolvedById: 'caller',
+      resolvedTimestamp: NOW,
+      resolutionSummary: 'rolled back',
+    });
+    expect(plan.events).toEqual([
+      {
+        eventType: 'RESOLVED',
+        metadata: { resolutionSummary: 'rolled back', serviceConfirmedWorking: true },
+      },
+    ]);
+  });
+
+  it.each(['OPEN', 'ACKNOWLEDGED', 'RESOLVED', 'CLOSED'] as const)('%s → 409', (status) => {
+    expect(failure(() => planResolve(incident({ status }), auth(), 's', NOW)).code).toBe(
+      'INVALID_STATE_TRANSITION',
+    );
+  });
+
+  it('an Engineer who is not the assignee gets NOT_CURRENT_ASSIGNEE; a Team Lead does not', () => {
+    const other = incident({ status: 'MITIGATING', currentAssigneeId: 'someone' });
+    expect(failure(() => planResolve(other, auth('ENGINEER'), 's', NOW)).code).toBe(
+      'NOT_CURRENT_ASSIGNEE',
+    );
+    expect(() => planResolve(other, auth('TEAM_LEAD'), 's', NOW)).not.toThrow();
+  });
+});
diff --git a/backend/src/modules/incidents/lifecycle/lifecycle.plans.ts b/backend/src/modules/incidents/lifecycle/lifecycle.plans.ts
new file mode 100644
index 0000000..31046ce
--- /dev/null
+++ b/backend/src/modules/incidents/lifecycle/lifecycle.plans.ts
@@ -0,0 +1,187 @@
+import type { AuthContext } from '../../../shared/types/auth-context.js';
+import type { Severity } from '../incidents.types.js';
+import {
+  assertMayResolve,
+  assertMaySetSeverity,
+  assertRequiredState,
+  UNRESOLVED_STATUSES,
+} from './lifecycle.rules.js';
+import { NO_CHANGE, type LockedIncident, type OutboxStep, type Plan } from './lifecycle.types.js';
+
+const slaEvaluation = (incident: LockedIncident): OutboxStep => ({
+  eventType: 'SLA_EVALUATION_REQUESTED',
+  aggregateType: 'INCIDENT',
+  aggregateId: incident.id,
+  payload: { incidentId: incident.id },
+});
+
+/** I3: `OPEN → ACKNOWLEDGED`; an unassigned incident is auto-assigned to the caller. */
+export function planAcknowledge(incident: LockedIncident, callerId: string, now: Date): Plan {
+  assertRequiredState(incident.status, ['OPEN']);
+  const autoAssigned = incident.currentAssigneeId === null;
+  return {
+    changes: {
+      status: 'ACKNOWLEDGED',
+      acknowledgedById: callerId,
+      acknowledgedTimestamp: now,
+      ...(autoAssigned ? { currentAssigneeId: callerId } : {}),
+    },
+    events: [
+      ...(autoAssigned
+        ? [
+            {
+              eventType: 'ASSIGNED' as const,
+              metadata: { from: null, to: callerId, auto: true },
+              subjectUserId: callerId,
+            },
+          ]
+        : []),
+      {
+        eventType: 'ACKNOWLEDGED',
+        metadata: { acknowledgedBy: callerId, autoAssigned },
+        subjectUserId: callerId,
+      },
+    ],
+    outbox: [],
+  };
+}
+
+/** I4: `ACKNOWLEDGED → MITIGATING` with the confirmed severity (written even when unchanged). */
+export function planConfirmSeverity(
+  incident: LockedIncident,
+  severity: Severity,
+  callerId: string,
+  now: Date,
+): Plan {
+  assertRequiredState(incident.status, ['ACKNOWLEDGED']);
+  return {
+    changes: {
+      severity,
+      severityConfirmedById: callerId,
+      severityConfirmTimestamp: now,
+      status: 'MITIGATING',
+    },
+    events: [
+      {
+        eventType: 'SEVERITY_CONFIRMED',
+        metadata: {
+          from: incident.severity,
+          to: severity,
+          statusFrom: 'ACKNOWLEDGED',
+          statusTo: 'MITIGATING',
+        },
+      },
+    ],
+    outbox: [slaEvaluation(incident)],
+  };
+}
+
+/** I5: severity change in any unresolved status; the same value is a no-op. */
+export function planChangeSeverity(
+  incident: LockedIncident,
+  severity: Severity,
+  auth: AuthContext,
+): Plan {
+  assertRequiredState(incident.status, UNRESOLVED_STATUSES);
+  assertMaySetSeverity(auth, incident.status);
+  if (incident.severity === severity) return NO_CHANGE;
+  return {
+    changes: { severity },
+    events: [
+      {
+        eventType: 'SEVERITY_CONFIRMED',
+        metadata: {
+          from: incident.severity,
+          to: severity,
+          statusFrom: incident.status,
+          statusTo: incident.status,
+        },
+      },
+    ],
+    outbox: [slaEvaluation(incident)],
+  };
+}
+
+/** I6: (re)assign in any unresolved status; the current assignee again is a no-op. */
+export function planAssign(incident: LockedIncident, assigneeId: string): Plan {
+  assertRequiredState(incident.status, UNRESOLVED_STATUSES);
+  const previous = incident.currentAssigneeId;
+  if (previous === assigneeId) return NO_CHANGE;
+  return {
+    changes: { currentAssigneeId: assigneeId },
+    events: [
+      previous === null
+        ? {
+            eventType: 'ASSIGNED',
+            metadata: { from: null, to: assigneeId, auto: false },
+            subjectUserId: assigneeId,
+          }
+        : {
+            eventType: 'REASSIGNED',
+            metadata: { from: previous, to: assigneeId },
+            subjectUserId: assigneeId,
+          },
+    ],
+    outbox: [],
+  };
+}
+
+/** I7: drop the assignee and the acknowledgement and return to `OPEN`. */
+export function planUnassign(incident: LockedIncident): Plan {
+  assertRequiredState(incident.status, UNRESOLVED_STATUSES);
+  const previous = incident.currentAssigneeId;
+  const returnsToOpen = incident.status !== 'OPEN';
+  if (previous === null && !returnsToOpen) return NO_CHANGE;
+  return {
+    changes: {
+      currentAssigneeId: null,
+      status: 'OPEN',
+      acknowledgedById: null,
+      acknowledgedTimestamp: null,
+    },
+    events: [
+      ...(previous === null
+        ? []
+        : [
+            {
+              eventType: 'REASSIGNED' as const,
+              metadata: { from: previous, to: null },
+              subjectUserId: previous,
+            },
+          ]),
+      ...(returnsToOpen
+        ? [{ eventType: 'OPEN' as const, metadata: { statusFrom: incident.status } }]
+        : []),
+    ],
+    outbox: returnsToOpen ? [slaEvaluation(incident)] : [],
+  };
+}
+
+/**
+ * I8: `MITIGATING → RESOLVED`. The postmortem row, the cleared alert keys and the generation
+ * outbox event are added by the action, which knows the postmortem id.
+ */
+export function planResolve(
+  incident: LockedIncident,
+  auth: AuthContext,
+  resolutionSummary: string,
+  now: Date,
+): Plan {
+  assertRequiredState(incident.status, ['MITIGATING']);
+  assertMayResolve(auth, incident.currentAssigneeId);
+  return {
+    changes: {
+      status: 'RESOLVED',
+      resolvedById: auth.userId,
+      resolvedTimestamp: now,
+      resolutionSummary,
+    },
+    events: [
+      {
+        eventType: 'RESOLVED',
+        metadata: { resolutionSummary, serviceConfirmedWorking: true },
+      },
+    ],
+    outbox: [],
+  };
+}
diff --git a/backend/src/modules/incidents/lifecycle/lifecycle.repository.ts b/backend/src/modules/incidents/lifecycle/lifecycle.repository.ts
new file mode 100644
index 0000000..4ce80d1
--- /dev/null
+++ b/backend/src/modules/incidents/lifecycle/lifecycle.repository.ts
@@ -0,0 +1,69 @@
+import { Prisma } from '../../../generated/prisma/client.js';
+import type { Db } from '../incidents.common.js';
+import type { IncidentStatus, Severity } from '../incidents.types.js';
+import type { IncidentChanges, LockedIncident, TransitionScope } from './lifecycle.types.js';
+import type { AssigneeCandidate } from './lifecycle.rules.js';
+
+/** Read before the transaction opens: the team gate and the pre-lock gates use it. */
+export function findTransitionScope(db: Db, id: string): Promise<TransitionScope | null> {
+  return db.incident.findUnique({
+    where: { id },
+    select: { teamId: true, affectedServiceId: true, status: true },
+  });
+}
+
+/** Bounds the wait for any lock taken in this transaction (`SET LOCAL`, gone at commit). */
+export async function setLockTimeout(db: Db, milliseconds: number): Promise<void> {
+  await db.$queryRaw(Prisma.sql`SELECT set_config('lock_timeout', ${`${milliseconds}ms`}, true)`);
+}
+
+/** `SELECT … FOR UPDATE` on the incident: the state is read under the lock. `null` if missing. */
+export async function lockIncidentForUpdate(db: Db, id: string): Promise<LockedIncident | null> {
+  const rows = await db.$queryRaw<
+    {
+      id: string;
+      teamId: string;
+      affectedServiceId: string;
+      status: IncidentStatus;
+      severity: Severity;
+      currentAssigneeId: string | null;
+      acknowledgedById: string | null;
+    }[]
+  >(Prisma.sql`
+    SELECT "id", "teamId", "affectedServiceId", "status"::text AS "status",
+           "severity"::text AS "severity", "currentAssigneeId", "acknowledgedById"
+    FROM "Incident" WHERE "id" = ${id}::uuid FOR UPDATE`);
+  return rows[0] ?? null;
+}
+
+/**
+ * `FOR SHARE` on a user row, returning what assignment eligibility needs (`null` if missing). A
+ * concurrent U4 (which locks the user `FOR UPDATE` before checking `acknowledgedBy`) waits for
+ * this transaction, so a user cannot be deactivated or moved between this check and the commit.
+ */
+export async function lockUserForShare(db: Db, id: string): Promise<AssigneeCandidate | null> {
+  const rows = await db.$queryRaw<AssigneeCandidate[]>(Prisma.sql`
+    SELECT "role"::text AS "role", "status"::text AS "status", "teamId"
+    FROM "User" WHERE "id" = ${id}::uuid FOR SHARE`);
+  return rows[0] ?? null;
+}
+
+export async function updateIncident(db: Db, id: string, changes: IncidentChanges): Promise<void> {
+  await db.incident.update({ where: { id }, data: { ...changes, updatedAt: new Date() } });
+}
+
+/** Resolve frees the identity of every alert of the incident, so a new firing opens a new incident. */
+export async function clearActiveIdentityKeys(db: Db, incidentId: string): Promise<void> {
+  await db.alert.updateMany({
+    where: { incidentId, activeIdentityKey: { not: null } },
+    data: { activeIdentityKey: null, updatedAt: new Date() },
+  });
+}
+
+/** `Postmortem.incidentId` is unique: a second postmortem for the incident cannot exist. */
+export function insertGeneratingPostmortem(db: Db, incidentId: string): Promise<{ id: string }> {
+  return db.postmortem.create({
+    data: { incidentId, generationStatus: 'GENERATING', reviewStatus: 'PENDING' },
+    select: { id: true },
+  });
+}
diff --git a/backend/src/modules/incidents/lifecycle/lifecycle.rules.spec.ts b/backend/src/modules/incidents/lifecycle/lifecycle.rules.spec.ts
new file mode 100644
index 0000000..53f2df9
--- /dev/null
+++ b/backend/src/modules/incidents/lifecycle/lifecycle.rules.spec.ts
@@ -0,0 +1,110 @@
+import type { AppError } from '../../../shared/errors/AppError.js';
+import type { AuthContext } from '../../../shared/types/auth-context.js';
+import {
+  assertChainMember,
+  assertMayResolve,
+  assertMaySetSeverity,
+  assertRequiredState,
+  isChainMember,
+  isEligibleAssignee,
+  requireManagerRole,
+} from './lifecycle.rules.js';
+
+const auth = (role: AuthContext['role'], userId = 'u1'): AuthContext => ({
+  userId,
+  email: 'a@example.com',
+  role,
+  teamId: 't1',
+  sessionId: 's1',
+});
+const thrown = (fn: () => void): AppError => {
+  try {
+    fn();
+  } catch (error) {
+    return error as AppError;
+  }
+  throw new Error('did not throw');
+};
+
+describe('assertRequiredState', () => {
+  it('passes inside the allowed set', () => {
+    expect(() => assertRequiredState('OPEN', ['OPEN', 'ACKNOWLEDGED'])).not.toThrow();
+  });
+
+  it('reports a single required status as a string', () => {
+    const error = thrown(() => assertRequiredState('OPEN', ['MITIGATING']));
+    expect([error.statusCode, error.code]).toEqual([409, 'INVALID_STATE_TRANSITION']);
+    expect(error.details).toEqual([{ currentStatus: 'OPEN', requiredStatus: 'MITIGATING' }]);
+  });
+
+  it('reports the allowed set for multi-state actions', () => {
+    const error = thrown(() => assertRequiredState('RESOLVED', ['OPEN', 'ACKNOWLEDGED']));
+    expect(error.details).toEqual([
+      { currentStatus: 'RESOLVED', requiredStatus: ['OPEN', 'ACKNOWLEDGED'] },
+    ]);
+  });
+});
+
+describe('role rules', () => {
+  it('requireManagerRole: Team Lead and Admin pass, Engineer is FORBIDDEN_ROLE', () => {
+    expect(() => requireManagerRole(auth('TEAM_LEAD'))).not.toThrow();
+    expect(() => requireManagerRole(auth('ADMIN'))).not.toThrow();
+    expect(thrown(() => requireManagerRole(auth('ENGINEER'))).code).toBe('FORBIDDEN_ROLE');
+  });
+
+  it('assertMaySetSeverity: only an Engineer on an OPEN incident is refused', () => {
+    expect(thrown(() => assertMaySetSeverity(auth('ENGINEER'), 'OPEN')).code).toBe(
+      'FORBIDDEN_ROLE',
+    );
+    expect(() => assertMaySetSeverity(auth('ENGINEER'), 'ACKNOWLEDGED')).not.toThrow();
+    expect(() => assertMaySetSeverity(auth('TEAM_LEAD'), 'OPEN')).not.toThrow();
+    expect(() => assertMaySetSeverity(auth('ADMIN'), 'OPEN')).not.toThrow();
+  });
+
+  it('assertMayResolve: an Engineer must be the current assignee', () => {
+    expect(() => assertMayResolve(auth('ENGINEER', 'u1'), 'u1')).not.toThrow();
+    expect(thrown(() => assertMayResolve(auth('ENGINEER', 'u1'), 'u2')).code).toBe(
+      'NOT_CURRENT_ASSIGNEE',
+    );
+    expect(thrown(() => assertMayResolve(auth('ENGINEER', 'u1'), null)).code).toBe(
+      'NOT_CURRENT_ASSIGNEE',
+    );
+    expect(() => assertMayResolve(auth('TEAM_LEAD'), 'u2')).not.toThrow();
+    expect(() => assertMayResolve(auth('ADMIN'), null)).not.toThrow();
+  });
+});
+
+describe('escalation chain', () => {
+  const chain = { level1: 'a', level2: 'b', level3: 'c', fallbackAdmin: 'd' };
+
+  it.each(['a', 'b', 'c', 'd'])('%s is a member', (id) => {
+    expect(isChainMember(chain, id)).toBe(true);
+  });
+
+  it('refuses a user outside the chain, and every user when there is no policy', () => {
+    expect(thrown(() => assertChainMember(chain, 'x'))).toMatchObject({
+      statusCode: 403,
+      code: 'FORBIDDEN',
+    });
+    expect(isChainMember(null, 'a')).toBe(false);
+  });
+});
+
+describe('isEligibleAssignee', () => {
+  const ok = { role: 'ENGINEER', status: 'ACTIVE', teamId: 't1' } as const;
+
+  it('accepts an active Engineer or Team Lead of the incident team', () => {
+    expect(isEligibleAssignee(ok, 't1')).toBe(true);
+    expect(isEligibleAssignee({ ...ok, role: 'TEAM_LEAD' }, 't1')).toBe(true);
+  });
+
+  it.each([
+    ['a user that does not exist', null],
+    ['a user of another team', { ...ok, teamId: 't2' }],
+    ['a user without a team', { ...ok, teamId: null }],
+    ['a deactivated user', { ...ok, status: 'DEACTIVATED' as const }],
+    ['an Admin', { ...ok, role: 'ADMIN' as const }],
+  ])('rejects %s', (_name, candidate) => {
+    expect(isEligibleAssignee(candidate, 't1')).toBe(false);
+  });
+});
diff --git a/backend/src/modules/incidents/lifecycle/lifecycle.rules.ts b/backend/src/modules/incidents/lifecycle/lifecycle.rules.ts
new file mode 100644
index 0000000..6b7c270
--- /dev/null
+++ b/backend/src/modules/incidents/lifecycle/lifecycle.rules.ts
@@ -0,0 +1,92 @@
+import { ConflictError, ForbiddenError } from '../../../shared/errors/AppError.js';
+import type { AuthContext } from '../../../shared/types/auth-context.js';
+import type { IncidentStatus } from '../incidents.types.js';
+
+/** Statuses in which severity and assignment may still change. */
+export const UNRESOLVED_STATUSES: readonly IncidentStatus[] = [
+  'OPEN',
+  'ACKNOWLEDGED',
+  'MITIGATING',
+];
+
+/** Gate 3: `409 INVALID_STATE_TRANSITION`; `requiredStatus` is one status or the allowed set. */
+export function assertRequiredState(
+  current: IncidentStatus,
+  required: readonly IncidentStatus[],
+): void {
+  if (required.includes(current)) return;
+  throw new ConflictError(
+    'The incident is not in a state that allows this action',
+    'INVALID_STATE_TRANSITION',
+    [
+      {
+        currentStatus: current,
+        requiredStatus: required.length === 1 ? required[0] : [...required],
+      },
+    ],
+  );
+}
+
+/** Gate 1 for I6 and I7. */
+export function requireManagerRole(auth: AuthContext): void {
+  if (auth.role === 'ENGINEER') {
+    throw new ForbiddenError('Role is not allowed to perform this action', 'FORBIDDEN_ROLE');
+  }
+}
+
+/** I5: an Engineer may not change the severity of an `OPEN` incident. */
+export function assertMaySetSeverity(auth: AuthContext, status: IncidentStatus): void {
+  if (auth.role === 'ENGINEER' && status === 'OPEN') {
+    throw new ForbiddenError('Role is not allowed to perform this action', 'FORBIDDEN_ROLE');
+  }
+}
+
+/** I8: Team Leads and Admins resolve any incident, an Engineer only as the current assignee. */
+export function assertMayResolve(auth: AuthContext, currentAssigneeId: string | null): void {
+  if (auth.role === 'ENGINEER' && currentAssigneeId !== auth.userId) {
+    throw new ForbiddenError('Only the current assignee may resolve', 'NOT_CURRENT_ASSIGNEE');
+  }
+}
+
+export type EscalationChain = {
+  level1: string;
+  level2: string;
+  level3: string;
+  fallbackAdmin: string;
+};
+
+/** The four users of the service's escalation policy. */
+export function isChainMember(chain: EscalationChain | null, userId: string): boolean {
+  if (chain === null) return false;
+  return [chain.level1, chain.level2, chain.level3, chain.fallbackAdmin].includes(userId);
+}
+
+export function assertChainMember(chain: EscalationChain | null, userId: string): void {
+  if (!isChainMember(chain, userId)) {
+    throw new ForbiddenError('Caller is not in the escalation chain of the service', 'FORBIDDEN');
+  }
+}
+
+export type AssigneeCandidate = {
+  role: 'ENGINEER' | 'TEAM_LEAD' | 'ADMIN';
+  status: 'ACTIVE' | 'DEACTIVATED';
+  teamId: string | null;
+};
+
+/** I6: an `ACTIVE` Engineer or Team Lead of the incident's team (a missing user is `null`). */
+export function isEligibleAssignee(candidate: AssigneeCandidate | null, teamId: string): boolean {
+  return (
+    candidate !== null &&
+    candidate.status === 'ACTIVE' &&
+    candidate.teamId === teamId &&
+    (candidate.role === 'ENGINEER' || candidate.role === 'TEAM_LEAD')
+  );
+}
+
+/** One generic error for every ineligible assignee: it never reveals whether the user exists. */
+export function assigneeNotEligible(): ForbiddenError {
+  return new ForbiddenError(
+    'The user cannot be assigned to this incident',
+    'ASSIGNEE_NOT_ELIGIBLE',
+  );
+}
diff --git a/backend/src/modules/incidents/lifecycle/lifecycle.service.ts b/backend/src/modules/incidents/lifecycle/lifecycle.service.ts
new file mode 100644
index 0000000..860b685
--- /dev/null
+++ b/backend/src/modules/incidents/lifecycle/lifecycle.service.ts
@@ -0,0 +1,176 @@
+import { getEscalationPolicyByService } from '../../appService/index.js';
+import { ValidationError, BadRequestError } from '../../../shared/errors/AppError.js';
+import type { AuthContext } from '../../../shared/types/auth-context.js';
+import { findIncidentDetail } from '../incident.repository.js';
+import { toIncidentResponse } from '../incident.mapper.js';
+import { incidentNotFound, type Db } from '../incidents.common.js';
+import type { IncidentResponse, Severity } from '../incidents.types.js';
+import {
+  clearActiveIdentityKeys,
+  insertGeneratingPostmortem,
+  lockUserForShare,
+} from './lifecycle.repository.js';
+import {
+  planAcknowledge,
+  planAssign,
+  planChangeSeverity,
+  planConfirmSeverity,
+  planResolve,
+  planUnassign,
+} from './lifecycle.plans.js';
+import {
+  assertChainMember,
+  assigneeNotEligible,
+  isEligibleAssignee,
+  requireManagerRole,
+} from './lifecycle.rules.js';
+import type { Plan } from './lifecycle.types.js';
+import { runTransition } from './transition.kernel.js';
+
+async function respondWith(tx: Db, incidentId: string): Promise<IncidentResponse> {
+  const row = await findIncidentDetail(tx, incidentId);
+  if (row === null) throw incidentNotFound();
+  return toIncidentResponse(row, new Date());
+}
+
+const chainGate = (auth: AuthContext) => async (scope: { affectedServiceId: string }) =>
+  assertChainMember(await getEscalationPolicyByService(scope.affectedServiceId), auth.userId);
+
+/** I3 acknowledge. Any role of the incident's team. */
+export function acknowledgeIncident(auth: AuthContext, incidentId: string, requestId: string) {
+  return runTransition({
+    auth,
+    incidentId,
+    requestId,
+    decide: async (tx, incident) => {
+      // The acknowledging user is read by U4's conflict check under a user row lock (known issue 8).
+      await lockUserForShare(tx, auth.userId);
+      return planAcknowledge(incident, auth.userId, new Date());
+    },
+    respond: (tx) => respondWith(tx, incidentId),
+  });
+}
+
+/** I4 confirm severity. Chain members only. */
+export function confirmSeverity(
+  auth: AuthContext,
+  incidentId: string,
+  severity: Severity,
+  requestId: string,
+) {
+  return runTransition({
+    auth,
+    incidentId,
+    requestId,
+    gate: chainGate(auth),
+    decide: (_tx, incident) => planConfirmSeverity(incident, severity, auth.userId, new Date()),
+    respond: (tx) => respondWith(tx, incidentId),
+  });
+}
+
+/** I5 change severity. Chain members; an Engineer not while the incident is `OPEN`. */
+export function changeSeverity(
+  auth: AuthContext,
+  incidentId: string,
+  severity: Severity,
+  requestId: string,
+) {
+  return runTransition({
+    auth,
+    incidentId,
+    requestId,
+    gate: chainGate(auth),
+    decide: (_tx, incident) => planChangeSeverity(incident, severity, auth),
+    respond: (tx) => respondWith(tx, incidentId),
+  });
+}
+
+/** I6 assign / reassign. Team Lead or Admin. */
+export function assignIncident(
+  auth: AuthContext,
+  incidentId: string,
+  assigneeId: string,
+  requestId: string,
+) {
+  requireManagerRole(auth);
+  return runTransition({
+    auth,
+    incidentId,
+    requestId,
+    decide: async (tx, incident) => {
+      const candidate = await lockUserForShare(tx, assigneeId);
+      if (!isEligibleAssignee(candidate, incident.teamId)) throw assigneeNotEligible();
+      return planAssign(incident, assigneeId);
+    },
+    respond: (tx) => respondWith(tx, incidentId),
+  });
+}
+
+/** I7 unassign. Team Lead or Admin. */
+export function unassignIncident(auth: AuthContext, incidentId: string, requestId: string) {
+  requireManagerRole(auth);
+  return runTransition({
+    auth,
+    incidentId,
+    requestId,
+    decide: (_tx, incident) => planUnassign(incident),
+    respond: (tx) => respondWith(tx, incidentId),
+  });
+}
+
+export type ResolveInput = { resolutionSummary?: string; serviceConfirmedWorking?: boolean };
+
+/**
+ * Body validation of I8, after Gate 2 and before the lock: the summary is required (`422`) and
+ * `serviceConfirmedWorking` must be `true` (`400`).
+ */
+function validateResolveInput(input: ResolveInput): string {
+  if (input.resolutionSummary === undefined) {
+    throw new ValidationError('resolutionSummary is required', 'VALIDATION_FAILED', [
+      { field: 'resolutionSummary', issue: 'Required' },
+    ]);
+  }
+  if (input.serviceConfirmedWorking !== true) {
+    throw new BadRequestError('serviceConfirmedWorking must be true to resolve an incident');
+  }
+  return input.resolutionSummary;
+}
+
+/**
+ * I8 resolve. In the same transaction: the `Postmortem` row (`GENERATING` / `PENDING`), the
+ * identity keys of every alert cleared, and the generation request in the outbox.
+ */
+export function resolveIncident(
+  auth: AuthContext,
+  incidentId: string,
+  input: ResolveInput,
+  requestId: string,
+) {
+  let resolutionSummary = '';
+  return runTransition({
+    auth,
+    incidentId,
+    requestId,
+    gate: () => {
+      resolutionSummary = validateResolveInput(input);
+    },
+    decide: async (tx, incident): Promise<Plan> => {
+      const plan = planResolve(incident, auth, resolutionSummary, new Date());
+      const postmortem = await insertGeneratingPostmortem(tx, incidentId);
+      await clearActiveIdentityKeys(tx, incidentId);
+      return {
+        ...plan,
+        outbox: [
+          ...plan.outbox,
+          {
+            eventType: 'POSTMORTEM_GENERATION_REQUESTED',
+            aggregateType: 'POSTMORTEM',
+            aggregateId: postmortem.id,
+            payload: { postmortemId: postmortem.id, incidentId },
+          },
+        ],
+      };
+    },
+    respond: (tx) => respondWith(tx, incidentId),
+  });
+}
diff --git a/backend/src/modules/incidents/lifecycle/lifecycle.types.ts b/backend/src/modules/incidents/lifecycle/lifecycle.types.ts
new file mode 100644
index 0000000..f5dfe8f
--- /dev/null
+++ b/backend/src/modules/incidents/lifecycle/lifecycle.types.ts
@@ -0,0 +1,51 @@
+import type { Prisma } from '../../../generated/prisma/client.js';
+import type { AuditEventType } from '../../../generated/prisma/enums.js';
+import type { IncidentStatus, Severity } from '../incidents.types.js';
+
+/** The incident row as read under `FOR UPDATE`. */
+export type LockedIncident = {
+  id: string;
+  teamId: string;
+  affectedServiceId: string;
+  status: IncidentStatus;
+  severity: Severity;
+  currentAssigneeId: string | null;
+  acknowledgedById: string | null;
+};
+
+/** What the team gate and the pre-lock gates need to know; read before the transaction opens. */
+export type TransitionScope = { teamId: string; affectedServiceId: string; status: IncidentStatus };
+
+/** The scalar columns a lifecycle action may change (API names are mapped in the repository). */
+export type IncidentChanges = Pick<
+  Prisma.IncidentUncheckedUpdateInput,
+  | 'status'
+  | 'severity'
+  | 'currentAssigneeId'
+  | 'acknowledgedById'
+  | 'acknowledgedTimestamp'
+  | 'severityConfirmedById'
+  | 'severityConfirmTimestamp'
+  | 'resolvedById'
+  | 'resolvedTimestamp'
+  | 'resolutionSummary'
+>;
+
+/** One audit event; the caller is its actor. Every event written also gets one notification. */
+export type AuditStep = {
+  eventType: AuditEventType;
+  metadata: Prisma.InputJsonObject;
+  subjectUserId?: string;
+};
+
+export type OutboxStep = {
+  eventType: 'SLA_EVALUATION_REQUESTED' | 'POSTMORTEM_GENERATION_REQUESTED';
+  aggregateType: string;
+  aggregateId: string;
+  payload: Record<string, unknown>;
+};
+
+/** A transition decided under the lock: nothing at all (a no-op) or changes with their events. */
+export type Plan = { changes: IncidentChanges; events: AuditStep[]; outbox: OutboxStep[] };
+
+export const NO_CHANGE: Plan = { changes: {}, events: [], outbox: [] };
diff --git a/backend/src/modules/incidents/lifecycle/transition.kernel.ts b/backend/src/modules/incidents/lifecycle/transition.kernel.ts
new file mode 100644
index 0000000..4b8e871
--- /dev/null
+++ b/backend/src/modules/incidents/lifecycle/transition.kernel.ts
@@ -0,0 +1,99 @@
+import { appendAuditEvent } from '../../../infra/audit/append-audit-event.js';
+import { getPrisma } from '../../../infra/db/prisma.js';
+import { enqueueOutbox } from '../../../infra/jobs/index.js';
+import type { AuthContext } from '../../../shared/types/auth-context.js';
+import { requireTeam } from '../../identity/index.js';
+import { enqueueNotification } from '../../notifications/index.js';
+import {
+  assertIncidentAccess,
+  runIncidentTransaction,
+  withDatabaseOutageMapping,
+  type Db,
+} from '../incidents.common.js';
+import { INCIDENT_LOCK_TIMEOUT_MS } from './lifecycle.config.js';
+import {
+  findTransitionScope,
+  lockIncidentForUpdate,
+  setLockTimeout,
+  updateIncident,
+} from './lifecycle.repository.js';
+import type { LockedIncident, Plan, TransitionScope } from './lifecycle.types.js';
+
+export type TransitionRequest<T> = {
+  auth: AuthContext;
+  incidentId: string;
+  /** Carried in every outbox payload for log correlation. */
+  requestId?: string;
+  /** Gate 2 beyond the team gate and body validation, before any lock (chain membership, …). */
+  gate?: (scope: TransitionScope) => Promise<void> | void;
+  /**
+   * Under the lock: re-check the state and the role-by-state rules, then decide the change. It
+   * may add writes of its own on `tx` (other rows), which commit with the transition.
+   */
+  decide: (tx: Db, incident: LockedIncident) => Promise<Plan> | Plan;
+  /** Builds the response on the same transaction, after the writes. */
+  respond: (tx: Db) => Promise<T>;
+  lockTimeoutMs?: number;
+};
+
+/**
+ * The transition kernel. One transaction: load and apply the team gate, lock the incident row
+ * with a bounded wait, `decide` under the lock, apply the changes, append the audit events in
+ * order, write the outbox events and one notification per audit event (`occurrenceId` = that
+ * event's id), then commit. Nothing external runs inside it. A lock timeout or deadlock is
+ * `409 CONCURRENCY_CONFLICT`; a database outage `503`.
+ */
+export async function runTransition<T>(request: TransitionRequest<T>): Promise<T> {
+  const { auth, incidentId } = request;
+  requireTeam(auth);
+
+  const scope = await withDatabaseOutageMapping(() => findTransitionScope(getPrisma(), incidentId));
+  assertIncidentAccess(auth, scope);
+  await request.gate?.(scope);
+
+  return runIncidentTransaction(async (tx) => {
+    await setLockTimeout(tx, request.lockTimeoutMs ?? INCIDENT_LOCK_TIMEOUT_MS);
+    const incident = await lockIncidentForUpdate(tx, incidentId);
+    assertIncidentAccess(auth, incident);
+
+    const plan = await request.decide(tx, incident);
+    if (Object.keys(plan.changes).length > 0) await updateIncident(tx, incidentId, plan.changes);
+
+    const occurrences: {
+      eventType: Plan['events'][number]['eventType'];
+      id: string;
+      subjectUserId?: string;
+    }[] = [];
+    for (const event of plan.events) {
+      const id = await appendAuditEvent(tx, {
+        incidentId,
+        eventType: event.eventType,
+        actorId: auth.userId,
+        metadata: event.metadata,
+      });
+      occurrences.push({ eventType: event.eventType, id, subjectUserId: event.subjectUserId });
+    }
+    for (const step of plan.outbox) {
+      await enqueueOutbox(tx, {
+        ...step,
+        payload: {
+          ...step.payload,
+          ...(request.requestId ? { requestId: request.requestId } : {}),
+        },
+      });
+    }
+    for (const occurrence of occurrences) {
+      await enqueueNotification(tx, {
+        eventType: occurrence.eventType,
+        occurrenceId: occurrence.id,
+        incidentId,
+        serviceId: incident.affectedServiceId,
+        teamId: incident.teamId,
+        ...(occurrence.subjectUserId === undefined
+          ? {}
+          : { subjectUserId: occurrence.subjectUserId }),
+      });
+    }
+    return request.respond(tx);
+  });
+}
