+import { ConfigError, parseAiConfig } from './env';
+
+const valid = {
+  GEMINI_API_KEY: 'AIza-key',
+  GEMINI_MODEL: 'gemini-flash-test',
+  AI_REQUEST_TIMEOUT_MS: '10000',
+};
+
+describe('parseAiConfig', () => {
