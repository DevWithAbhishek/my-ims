+      geminiModel: 'gemini-flash-test',
+      requestTimeoutMs: 10000,
+    });
+  });
+
+  it('has no defaults: every missing variable is reported by name, never by value', () => {
+    expect.assertions(3);
+    try {
+      parseAiConfig({});
