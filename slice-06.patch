+import type { RequestHandler } from 'express';
+import { parseOrThrow } from '../../../shared/errors/zod.js';
+import { getAuth } from '../../identity/index.js';
+import { incidentParamsSchema } from '../incident.schema.js';
+import { selectRow } from './incident-update.dispatcher.js';
+import { updateIncidentBodySchema } from './incident-update.schema.js';
+
+/** `PATCH /incidents/:incidentId`: validation first (400/422), then the one matching action. */
+export const updateIncidentHandler: RequestHandler = async (req, res) => {
+  const { incidentId } = parseOrThrow(incidentParamsSchema, req.params);
+  const body = parseOrThrow(updateIncidentBodySchema, req.body);
+  const row = selectRow(body);
+  const result = await row.handle({ auth: getAuth(req), incidentId, body });
+  res.status(result.status).json({ data: result.data });
+};
diff --git a/backend/src/modules/incidents/update/incident-update.dispatcher.spec.ts b/backend/src/modules/incidents/update/incident-update.dispatcher.spec.ts
new file mode 100644
index 0000000..f7553d8
--- /dev/null
+++ b/backend/src/modules/incidents/update/incident-update.dispatcher.spec.ts
@@ -0,0 +1,85 @@
+import { AppError } from '../../../shared/errors/AppError.js';
+import { parseOrThrow } from '../../../shared/errors/zod.js';
+import {
+  presentFields,
+  selectRow,
+  UPDATE_ROWS,
+  type UpdateRow,
+} from './incident-update.dispatcher.js';
+import { updateIncidentBodySchema } from './incident-update.schema.js';
+
+const parse = (body: unknown) => parseOrThrow(updateIncidentBodySchema, body);
+const code = (fn: () => unknown): { status: number; code: string } => {
+  try {
+    fn();
+  } catch (error) {
+    const { statusCode, code: errorCode } = error as AppError;
+    return { status: statusCode, code: errorCode };
+  }
+  throw new Error('did not throw');
+};
+
+describe('update body schema', () => {
+  it('trims the comment body and keeps the title as sent', () => {
+    expect(parse({ comment: { title: 'T', body: '  hello  ' } })).toEqual({
+      comment: { title: 'T', body: 'hello' },
+    });
+  });
+
+  it.each([
+    ['whitespace-only body', { comment: { body: '   ' } }],
+    ['missing body', { comment: { title: 'x' } }],
+    ['body over 10,000 characters', { comment: { body: 'a'.repeat(10_001) } }],
+    ['title over 200 characters', { comment: { title: 'a'.repeat(201), body: 'x' } }],
+    ['malformed assignee', { currentAssignee: 'nope' }],
+    ['unknown status', { status: 'CLOSED' }],
+  ])('rejects %s with 422', (_name, body) => {
+    expect(code(() => parse(body))).toEqual({ status: 422, code: 'VALIDATION_FAILED' });
+  });
+
+  it.each([
+    ['an unknown top-level field', { comment: { body: 'x' }, author: 'me' }],
+    ['an unknown comment field', { comment: { body: 'x', authorId: 'me' } }],
+  ])('rejects %s with 400', (_name, body) => {
+    expect(code(() => parse(body))).toEqual({ status: 400, code: 'BAD_REQUEST' });
+  });
+
+  it('accepts the maximum body and title lengths', () => {
+    expect(() =>
+      parse({ comment: { title: 'a'.repeat(200), body: 'a'.repeat(10_000) } }),
+    ).not.toThrow();
+  });
+});
+
+describe('selectRow', () => {
+  it('selects the comment row for exactly { comment }', () => {
+    expect(selectRow(parse({ comment: { body: 'x' } })).id).toBe('I10');
+  });
+
+  it.each([
+    ['an empty body', {}],
+    ['an action owned by another slice', { status: 'ACKNOWLEDGED' }],
+    ['a null assignee (present, matches no row yet)', { currentAssignee: null }],
+    ['a comment combined with another field', { comment: { body: 'x' }, severity: 'P1' }],
+  ])('rejects %s with 422', (_name, body) => {
+    expect(code(() => selectRow(parse(body)))).toEqual({ status: 422, code: 'VALIDATION_FAILED' });
+  });
+
+  it('rejects a body that matches more than one row', () => {
+    const row = (id: string): UpdateRow => ({
+      id,
+      matches: () => true,
+      handle: () => Promise.reject(new Error('unused')),
+    });
+    expect(code(() => selectRow(parse({ severity: 'P1' }), [row('a'), row('b')])).status).toBe(422);
+    expect(selectRow(parse({ severity: 'P1' }), [row('a')]).id).toBe('a');
+  });
+
+  it('counts null as a present field and ignores undefined', () => {
+    expect(presentFields(parse({ currentAssignee: null, severity: 'P1' })).sort()).toEqual([
+      'currentAssignee',
+      'severity',
+    ]);
+    expect(UPDATE_ROWS.map((row) => row.id)).toEqual(['I10']);
+  });
+});
diff --git a/backend/src/modules/incidents/update/incident-update.dispatcher.ts b/backend/src/modules/incidents/update/incident-update.dispatcher.ts
new file mode 100644
index 0000000..d740815
--- /dev/null
+++ b/backend/src/modules/incidents/update/incident-update.dispatcher.ts
@@ -0,0 +1,47 @@
+import { ValidationError } from '../../../shared/errors/AppError.js';
+import type { AuthContext } from '../../../shared/types/auth-context.js';
+import { addComment } from '../comments/comment.service.js';
+import type { UpdateIncidentBody } from './incident-update.schema.js';
+
+export type UpdateContext = { auth: AuthContext; incidentId: string; body: UpdateIncidentBody };
+export type UpdateResult = { status: number; data: unknown };
+
+/** One action of `PATCH /incidents/:incidentId` (I3–I8, I10): the body shape it owns and its handler. */
+export type UpdateRow = {
+  id: string;
+  matches: (presentFields: string[]) => boolean;
+  handle: (context: UpdateContext) => Promise<UpdateResult>;
+};
+
+/** I10: exactly `{ comment }`. Rows of other slices are added here by the slice that owns them. */
+const commentRow: UpdateRow = {
+  id: 'I10',
+  matches: (fields) => fields.length === 1 && fields[0] === 'comment',
+  handle: async ({ auth, incidentId, body }) => ({
+    status: 201,
+    data: await addComment(auth, incidentId, body.comment as NonNullable<typeof body.comment>),
+  }),
+};
+
+export const UPDATE_ROWS: readonly UpdateRow[] = [commentRow];
+
+/** The names of the fields the request actually carries (`null` counts as present). */
+export function presentFields(body: UpdateIncidentBody): string[] {
+  return Object.entries(body)
+    .filter(([, value]) => value !== undefined)
+    .map(([key]) => key);
+}
+
+/** A request must match exactly one row; none or several is `422 VALIDATION_FAILED`. */
+export function selectRow(body: UpdateIncidentBody, rows: readonly UpdateRow[] = UPDATE_ROWS) {
+  const fields = presentFields(body);
+  const matching = rows.filter((row) => row.matches(fields));
+  if (matching.length !== 1) {
+    throw new ValidationError(
+      'Request must match exactly one incident action',
+      'VALIDATION_FAILED',
+      [{ field: '', issue: 'Request must match exactly one incident action' }],
+    );
+  }
+  return matching[0];
+}
diff --git a/backend/src/modules/incidents/update/incident-update.schema.ts b/backend/src/modules/incidents/update/incident-update.schema.ts
