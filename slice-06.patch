+
+export type AlertSummary = {
+  id: string;
+  name: string | null;
+  environment: string;
+  sourceSeverity: string | null;
+  initialSeverity: Severity | null;
+  sourceStatus: AlertSourceStatus;
+  startedAt: string;
+  endedAt: string | null;
+  sourceUrl: string | null;
