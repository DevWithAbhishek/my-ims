+/** The 22 audit event types the timeline exposes; the 8 administrative ones are never returned. */
+export const INCIDENT_EVENT_TYPES = [
+  'ALERT_RECEIVED',
+  'ALERT_DUPLICATE',
+  'AI_TRIAGE_COMPLETED',
+  'INCIDENT_CREATED',
+  'ASSIGNED',
