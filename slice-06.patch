+/** Last `createdAt` (epoch ms) handed out per transaction handle. */
+const lastCreatedAt = new WeakMap<TransactionClient, number>();
+
+/**
+ * The event's `createdAt`: the current time, but always at least 1 ms after the previous event
+ * written on the same transaction. The database default would be the transaction start time and
+ * the column has millisecond precision, so without this events of one command could tie.
+ */
+function nextCreatedAt(tx: TransactionClient): Date {
+  const previous = lastCreatedAt.get(tx) ?? Number.NEGATIVE_INFINITY;
+  const next = Math.max(Date.now(), previous + 1);
+  lastCreatedAt.set(tx, next);
+  return new Date(next);
+}
+
 /**
  * Appends one audit event on the caller's transaction, so it commits or rolls back with the change
  * it describes. It never opens or commits a transaction and offers no update or delete path.
+ * Events written by one command appear in the order written.
  */
 export async function appendAuditEvent(tx: TransactionClient, input: AuditEventInput) {
   await tx.auditEvent.create({
@@ -20,6 +36,7 @@ export async function appendAuditEvent(tx: TransactionClient, input: AuditEventI
       actor: input.actorId,
       incidentId: input.incidentId,
       metadata: input.metadata,
+      createdAt: nextCreatedAt(tx),
     },
   });
 }
diff --git a/backend/src/infra/db/errors.spec.ts b/backend/src/infra/db/errors.spec.ts
new file mode 100644
index 0000000..cbeae44
--- /dev/null
+++ b/backend/src/infra/db/errors.spec.ts
@@ -0,0 +1,40 @@
+import { Prisma } from '../../generated/prisma/client.js';
+import { isDatabaseUnavailable } from './errors.js';
+
+function known(code: string, meta?: Record<string, unknown>) {
+  return new Prisma.PrismaClientKnownRequestError('boom', { code, clientVersion: 'test', meta });
+}
+
+describe('isDatabaseUnavailable', () => {
+  it.each(['P1001', 'P1002', 'P1008', 'P1017', 'P2024'])(
+    'treats Prisma %s as an outage',
+    (code) => {
+      expect(isDatabaseUnavailable(known(code))).toBe(true);
+    },
+  );
+
+  it('treats a raw query that could not reach the database as an outage', () => {
+    const error = known('P2010', {
+      driverAdapterError: { cause: { kind: 'DatabaseNotReachable', host: 'h', port: 5432 } },
+    });
+    expect(isDatabaseUnavailable(error)).toBe(true);
+  });
+
+  it('treats an initialization error and a refused connection as an outage', () => {
+    expect(
+      isDatabaseUnavailable(new Prisma.PrismaClientInitializationError('x', 'test', 'P1001')),
+    ).toBe(true);
+    expect(isDatabaseUnavailable(Object.assign(new Error('x'), { code: 'ECONNREFUSED' }))).toBe(
+      true,
+    );
+  });
+
+  it('does not treat query, constraint or unknown errors as an outage', () => {
+    expect(isDatabaseUnavailable(known('P2002'))).toBe(false);
+    expect(
+      isDatabaseUnavailable(known('P2010', { driverAdapterError: { cause: { kind: 'x' } } })),
+    ).toBe(false);
+    expect(isDatabaseUnavailable(new Error('nope'))).toBe(false);
+    expect(isDatabaseUnavailable(undefined)).toBe(false);
+  });
+});
diff --git a/backend/src/infra/db/errors.ts b/backend/src/infra/db/errors.ts
index a9bfa3b..0b6127f 100644
--- a/backend/src/infra/db/errors.ts
+++ b/backend/src/infra/db/errors.ts
@@ -18,3 +18,33 @@ export function isConcurrencyFailure(error: unknown): boolean {
   const state = sqlState(error);
   return state === '40001' || state === '40P01' || state === '55P03';
 }
+
+const UNAVAILABLE_PRISMA_CODES = new Set(['P1001', 'P1002', 'P1008', 'P1017', 'P2024']);
+const UNAVAILABLE_ADAPTER_KINDS = new Set([
+  'DatabaseNotReachable',
+  'ConnectionClosed',
+  'TooManyConnections',
+  'SocketTimeout',
+]);
+const UNAVAILABLE_NETWORK_CODES = new Set(['ECONNREFUSED', 'ECONNRESET', 'ETIMEDOUT', 'ENOTFOUND']);
+
+function adapterErrorKind(error: Prisma.PrismaClientKnownRequestError): string | undefined {
+  const meta = error.meta as { driverAdapterError?: { cause?: { kind?: unknown } } } | undefined;
+  const kind = meta?.driverAdapterError?.cause?.kind;
+  return typeof kind === 'string' ? kind : undefined;
+}
+
+/**
+ * The database cannot be reached or its connection pool is exhausted: a connection failure, not a
+ * query or data error. Raw queries report this as `P2010` with the cause in the driver adapter error.
+ */
+export function isDatabaseUnavailable(error: unknown): boolean {
+  if (error instanceof Prisma.PrismaClientInitializationError) return true;
+  if (error instanceof Prisma.PrismaClientKnownRequestError) {
+    if (UNAVAILABLE_PRISMA_CODES.has(error.code)) return true;
+    const kind = adapterErrorKind(error);
+    return kind !== undefined && UNAVAILABLE_ADAPTER_KINDS.has(kind);
+  }
+  const state = sqlState(error);
+  return state !== undefined && UNAVAILABLE_NETWORK_CODES.has(state);
+}
