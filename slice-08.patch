+# Copy to .env and adjust. Nothing here is a production value.
+
+# --- Application (SLICE-00) ---------------------------------------------------
+NODE_ENV=development
+PORT=3000
+DATABASE_URL=postgresql://postgres:postgres@localhost:5431/ims
+DIRECT_URL=postgresql://postgres:postgres@localhost:5431/ims
+REDIS_URL=redis://localhost:6379
+JWT_SECRET=change-me-development-only
+# ACCESS_TOKEN_EXPIRY=15m
+# REFRESH_TOKEN_EXPIRY=7d
+
+# --- First Admin (npm run seed:admin, SLICE-01) --------------------------------
+SEED_ADMIN_NAME=Admin
+SEED_ADMIN_EMAIL=admin@example.com
+SEED_ADMIN_PASSWORD=ChangeMe123!
+
+# --- Outbox, relay and workers (SLICE-08) --------------------------------------
+# DEVELOPMENT EXAMPLE VALUES ONLY. The application has no built-in defaults: the worker and
+# `npm run redrive:outbox` refuse to start when any variable below is missing or invalid, and the
+# project owner decides the real values per environment. All durations are in milliseconds.
+
+# Relay: how often it looks for PENDING rows, and how many it claims per pass.
+OUTBOX_RELAY_POLL_INTERVAL_MS=1000
+OUTBOX_RELAY_BATCH_SIZE=50
+# How long a relay's claim is valid before another relay may take the row over.
+OUTBOX_CLAIM_LEASE_MS=30000
+# After publishing, how long a row may stay PROCESSING before recovery republishes it.
+OUTBOX_PROCESSING_WINDOW_MS=300000
+# Give up waiting for Redis on a single publish after this long (the publish is then retried).
+OUTBOX_PUBLISH_TIMEOUT_MS=5000
+# Publication retry backoff (no maximum number of attempts): base doubles per attempt up to the cap.
+OUTBOX_PUBLISH_BACKOFF_BASE_MS=1000
+OUTBOX_PUBLISH_BACKOFF_CAP_MS=60000
+
+# Job execution: total attempts per job (the design says 5) and the retry backoff.
+JOBS_EXECUTION_ATTEMPTS=5
+JOBS_EXECUTION_BACKOFF_BASE_MS=2000
+JOBS_EXECUTION_BACKOFF_CAP_MS=60000
+
+# Housekeeping: stale-PROCESSING recovery pass and SUCCESS-row retention.
+OUTBOX_STALE_RECOVERY_INTERVAL_MS=30000
+# Must not be below OUTBOX_PROCESSING_WINDOW_MS.
+OUTBOX_RETENTION_WINDOW_MS=604800000
+OUTBOX_RETENTION_INTERVAL_MS=3600000
+
+# Worker: jobs processed in parallel per queue, and per-queue rate limits
+# (at most *_MAX jobs per *_DURATION_MS).
+WORKER_CONCURRENCY=5
+JOBS_RATE_AI_TRIAGE_MAX=10
+JOBS_RATE_AI_TRIAGE_DURATION_MS=1000
+JOBS_RATE_SLA_ESCALATION_MAX=50
+JOBS_RATE_SLA_ESCALATION_DURATION_MS=1000
+JOBS_RATE_NOTIFICATIONS_MAX=20
+JOBS_RATE_NOTIFICATIONS_DURATION_MS=1000
+JOBS_RATE_POSTMORTEM_MAX=5
+JOBS_RATE_POSTMORTEM_DURATION_MS=1000
+JOBS_RATE_INVESTIGATION_MAX=5
+JOBS_RATE_INVESTIGATION_DURATION_MS=1000
