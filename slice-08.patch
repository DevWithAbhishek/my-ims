+import { ZodError } from 'zod';
+import { classifyError, NonRetryableJobError, RetryableJobError, sanitizeError } from './errors';
+
+describe('classifyError', () => {
+  it.each([
+    'INVALID_PAYLOAD',
+    'UNSUPPORTED_EVENT_TYPE',
+    'BUSINESS_RULE_VIOLATION',
+    'AUTHENTICATION_OR_CONFIGURATION',
+    'RESOURCE_NOT_FOUND',
+    'AUTHORIZATION_FAILURE',
+  ] as const)('treats %s as non-retryable', (reason) => {
+    expect(classifyError(new NonRetryableJobError(reason, 'x'))).toEqual({
+      retryable: false,
+      errorClass: reason,
+    });
+  });
+
+  it('treats typed retryable errors as retryable and keeps the provider delay', () => {
+    expect(classifyError(new RetryableJobError('RATE_LIMITED', 'x', 1500))).toEqual({
+      retryable: true,
+      errorClass: 'RATE_LIMITED',
+      retryAfterMs: 1500,
+    });
+  });
+
+  it('treats schema failures as an invalid payload', () => {
+    const issue = new ZodError([{ code: 'custom', path: ['a'], message: 'bad' }]);
+    expect(classifyError(issue)).toEqual({ retryable: false, errorClass: 'INVALID_PAYLOAD' });
+  });
+
+  it.each([
+    [{ code: '40P01' }, 'TRANSIENT_DATABASE'],
+    [{ code: '55P03' }, 'TRANSIENT_DATABASE'],
+    [{ code: 'ECONNREFUSED' }, 'NETWORK'],
+    [{ code: 'ETIMEDOUT' }, 'NETWORK'],
+  ])('maps %j to a retryable %s failure', (shape, errorClass) => {
+    expect(classifyError(Object.assign(new Error('x'), shape))).toEqual({
+      retryable: true,
+      errorClass,
+    });
+  });
+
+  it('maps a Redis request-limit error to REDIS_UNAVAILABLE', () => {
+    const error = new Error('x');
+    error.name = 'MaxRetriesPerRequestError';
+    expect(classifyError(error)).toEqual({ retryable: true, errorClass: 'REDIS_UNAVAILABLE' });
+  });
+
+  it('maps ioredis connectivity and BullMQ stalled-job errors', () => {
+    expect(classifyError(new Error('Connection is closed.')).errorClass).toBe('REDIS_UNAVAILABLE');
+    expect(classifyError(new Error('job stalled more than allowable limit')).errorClass).toBe(
+      'WORKER_INTERRUPTED',
+    );
+  });
+
+  it('treats unknown errors as retryable (limited by the attempt count)', () => {
+    expect(classifyError(new Error('boom'))).toEqual({
+      retryable: true,
+      errorClass: 'UNKNOWN_INTERNAL',
+    });
+    expect(classifyError('a string')).toEqual({ retryable: true, errorClass: 'UNKNOWN_INTERNAL' });
+  });
+});
+
+describe('sanitizeError', () => {
+  it('redacts URLs and tokens from deliberate consumer messages', () => {
+    const text = sanitizeError(
+      new RetryableJobError(
+        'NETWORK',
+        'GET https://user:pw@mail.example/send failed with Bearer abc.def.ghi',
+      ),
+    );
+    expect(text).not.toMatch(/user:pw|abc\.def/);
+    expect(text).toContain('[redacted-url]');
+  });
+
+  it('truncates long messages', () => {
+    expect(
+      sanitizeError(new NonRetryableJobError('INVALID_PAYLOAD', 'x'.repeat(2000))),
+    ).toHaveLength(500);
+  });
+
+  it('reduces library errors to type and code, never message or stack', () => {
+    const error = Object.assign(new Error('INSERT ... VALUES (secret-token, "body")'), {
+      code: 'P2002',
+    });
+    const text = sanitizeError(error);
+    expect(text).toBe('Error (P2002)');
+    expect(text).not.toMatch(/secret|INSERT|\n\s+at /);
+  });
+});
diff --git a/backend/src/infra/jobs/errors.ts b/backend/src/infra/jobs/errors.ts
new file mode 100644
index 0000000..790f7f9
--- /dev/null
+++ b/backend/src/infra/jobs/errors.ts
@@ -0,0 +1,128 @@
+import { ZodError } from 'zod';
+import { Prisma } from '../../generated/prisma/client.js';
+import { isConcurrencyFailure } from '../db/errors.js';
+
+export type RetryableReason =
+  | 'NETWORK'
+  | 'SERVICE_UNAVAILABLE'
+  | 'RATE_LIMITED'
+  | 'TRANSIENT_DATABASE'
+  | 'REDIS_UNAVAILABLE'
+  | 'WORKER_INTERRUPTED'
+  | 'UNKNOWN_INTERNAL';
+
+export type NonRetryableReason =
+  | 'INVALID_PAYLOAD'
+  | 'UNSUPPORTED_EVENT_TYPE'
+  | 'BUSINESS_RULE_VIOLATION'
+  | 'AUTHENTICATION_OR_CONFIGURATION'
+  | 'RESOURCE_NOT_FOUND'
+  | 'AUTHORIZATION_FAILURE';
+
+/** Thrown by consumers for a failure that is worth retrying (temporary network/service/provider). */
+export class RetryableJobError extends Error {
+  constructor(
+    readonly reason: RetryableReason,
+    message: string,
+    /** A delay supplied by the provider (for example on rate limiting); honored by the retry. */
+    readonly retryAfterMs?: number,
+  ) {
+    super(message);
+    this.name = 'RetryableJobError';
+  }
+}
+
+/** Thrown by consumers for a failure that retrying cannot fix: the job goes straight to dead letter. */
+export class NonRetryableJobError extends Error {
+  constructor(
+    readonly reason: NonRetryableReason,
+    message: string,
+  ) {
+    super(message);
+    this.name = 'NonRetryableJobError';
+  }
+}
+
+export type Classification = {
+  retryable: boolean;
+  errorClass: string;
+  retryAfterMs?: number;
+};
+
+const NETWORK_CODES = new Set([
+  'ECONNREFUSED',
+  'ECONNRESET',
+  'ETIMEDOUT',
+  'EPIPE',
+  'ENOTFOUND',
+  'EAI_AGAIN',
+  'EHOSTUNREACH',
+]);
+const PRISMA_TRANSIENT_CODES = new Set(['P1001', 'P1002', 'P1008', 'P1017', 'P2024', 'P2034']);
+
+function codeOf(error: unknown): string | undefined {
+  if (typeof error !== 'object' || error === null) return undefined;
+  const { code } = error as { code?: unknown };
+  return typeof code === 'string' ? code : undefined;
+}
+
+/** Maps any thrown value to a retry decision. Unknown errors are retryable (limited by attempts). */
+export function classifyError(error: unknown): Classification {
+  if (error instanceof NonRetryableJobError) {
+    return { retryable: false, errorClass: error.reason };
+  }
+  if (error instanceof RetryableJobError) {
+    return { retryable: true, errorClass: error.reason, retryAfterMs: error.retryAfterMs };
+  }
+  if (error instanceof ZodError) {
+    return { retryable: false, errorClass: 'INVALID_PAYLOAD' };
+  }
+  const code = codeOf(error);
+  if (isConcurrencyFailure(error)) {
+    return { retryable: true, errorClass: 'TRANSIENT_DATABASE' };
+  }
+  if (
+    (error instanceof Prisma.PrismaClientKnownRequestError ||
+      error instanceof Prisma.PrismaClientInitializationError) &&
+    code !== undefined &&
+    PRISMA_TRANSIENT_CODES.has(code)
+  ) {
+    return { retryable: true, errorClass: 'TRANSIENT_DATABASE' };
+  }
+  if (error instanceof Error && error.name === 'MaxRetriesPerRequestError') {
+    return { retryable: true, errorClass: 'REDIS_UNAVAILABLE' };
+  }
+  if (code !== undefined && NETWORK_CODES.has(code)) {
+    return { retryable: true, errorClass: 'NETWORK' };
+  }
+  if (error instanceof Error && /Connection is closed/i.test(error.message)) {
+    return { retryable: true, errorClass: 'REDIS_UNAVAILABLE' };
+  }
+  if (error instanceof Error && /stalled more than/i.test(error.message)) {
+    return { retryable: true, errorClass: 'WORKER_INTERRUPTED' };
+  }
+  return { retryable: true, errorClass: 'UNKNOWN_INTERNAL' };
+}
+
+const MAX_ERROR_LENGTH = 500;
+const REDACTIONS: [RegExp, string][] = [
+  [/\b[a-z][a-z0-9+.-]*:\/\/\S+/gi, '[redacted-url]'],
+  [/\bBearer\s+\S+/gi, 'Bearer [redacted]'],
+  [/\beyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]*/g, '[redacted-token]'],
+];
+
+/**
+ * The text stored in `lastError`. Only errors thrown deliberately by consumers keep their message
+ * (redacted and truncated); anything else is reduced to its type and code, because messages from
+ * drivers and libraries can contain SQL, parameters or payload fragments. Never a stack trace.
+ */
+export function sanitizeError(error: unknown): string {
+  if (error instanceof RetryableJobError || error instanceof NonRetryableJobError) {
+    let text = error.message;
+    for (const [pattern, replacement] of REDACTIONS) text = text.replace(pattern, replacement);
+    return text.slice(0, MAX_ERROR_LENGTH);
+  }
+  const name = error instanceof Error ? error.name : typeof error;
+  const code = codeOf(error);
+  return (code === undefined ? name : `${name} (${code})`).slice(0, MAX_ERROR_LENGTH);
+}
