@@ -0,0 +1,29 @@
+import { logger } from '../../shared/observability/logger.js';
+import { getPrisma } from '../db/prisma.js';
+import { deleteExpiredSuccess, recoverStaleProcessing } from './outbox.repository.js';
+
+/** Returns `PROCESSING` rows past their deadline to `PENDING` so the relay republishes them. */
+export async function recoverStaleOutbox(): Promise<number> {
+  const started = Date.now();
+  const recovered = await getPrisma().$transaction((tx) => recoverStaleProcessing(tx));
+  if (recovered > 0) {
+    logger.warn(
+      { recovered, outcome: 'stale_recovered', durationMs: Date.now() - started },
+      'Stale PROCESSING outbox rows returned to PENDING',
+    );
+  }
+  return recovered;
+}
+
+/** Deletes `SUCCESS` rows older than the retention window. `DEAD_LETTER` rows are never deleted. */
+export async function purgeFinishedOutbox(retentionMs: number): Promise<number> {
+  const started = Date.now();
+  const deleted = await getPrisma().$transaction((tx) => deleteExpiredSuccess(tx, retentionMs));
+  if (deleted > 0) {
+    logger.info(
+      { deleted, outcome: 'retention_deleted', durationMs: Date.now() - started },
+      'Finished outbox rows deleted by retention',
+    );
+  }
+  return deleted;
+}
diff --git a/backend/src/infra/jobs/outbox.repository.ts b/backend/src/infra/jobs/outbox.repository.ts
new file mode 100644
index 0000000..badc281
--- /dev/null
+++ b/backend/src/infra/jobs/outbox.repository.ts
@@ -0,0 +1,155 @@
+import { Prisma } from '../../generated/prisma/client.js';
+import type { TransactionClient } from '../db/prisma.js';
+
+/** Anything that can run raw SQL: the Prisma client or a transaction handle. */
+export type Db = Pick<TransactionClient, '$queryRaw' | '$executeRaw'>;
+
+/**
+ * Timestamps in `OutboxEvent` are `timestamp` columns holding UTC, so every comparison and
+ * assignment here uses the database clock converted to UTC.
+ */
+const NOW = Prisma.sql`timezone('UTC', now())`;
+const ms = (value: number) => Prisma.sql`(${value}::double precision * interval '1 millisecond')`;
+
+export type ClaimedEvent = {
+  id: string;
+  eventType: string;
+  aggregateType: string;
+  aggregateId: string;
+  payload: unknown;
+  publishAttemptCount: number;
+  executionAttemptCount: number;
+  /** The claim's lease expiry as stored, used to prove the claim is still ours on later updates. */
+  lease: string;
+};
+
+/**
+ * Claims up to `batchSize` publishable rows in one statement: `FOR UPDATE SKIP LOCKED` picks rows no
+ * other relay holds and the lease is set before the locks are released, so each row has one claimant.
+ */
+export function claimBatch(
+  db: Db,
+  batchSize: number,
+  claimLeaseMs: number,
+): Promise<ClaimedEvent[]> {
+  return db.$queryRaw<ClaimedEvent[]>(Prisma.sql`
+    UPDATE "OutboxEvent" SET "leaseExpiresAt" = ${NOW} + ${ms(claimLeaseMs)}
+    WHERE "id" IN (
+      SELECT "id" FROM "OutboxEvent"
+      WHERE "status" = 'PENDING'
+        AND "availableAt" <= ${NOW}
+        AND ("leaseExpiresAt" IS NULL OR "leaseExpiresAt" <= ${NOW})
+      ORDER BY "availableAt", "id"
+      LIMIT ${batchSize}
+      FOR UPDATE SKIP LOCKED
+    )
+    RETURNING "id", "eventType", "aggregateType", "aggregateId", "payload",
+      "publishAttemptCount", "executionAttemptCount", "leaseExpiresAt"::text AS "lease"`);
+}
+
+const holdsClaim = (id: string, lease: string) =>
+  Prisma.sql`"id" = ${id}::uuid AND "status" = 'PENDING' AND "leaseExpiresAt"::text = ${lease}`;
+
+/** The job is in BullMQ: `PENDING → PROCESSING` if the claim is still ours. */
+export async function markPublished(
+  db: Db,
+  id: string,
+  lease: string,
+  processingWindowMs: number,
+): Promise<boolean> {
+  const changed = await db.$executeRaw(Prisma.sql`
+    UPDATE "OutboxEvent" SET "status" = 'PROCESSING', "publishedAt" = ${NOW},
+      "publishAttemptCount" = "publishAttemptCount" + 1,
+      "leaseExpiresAt" = ${NOW} + ${ms(processingWindowMs)},
+      "errorClass" = NULL, "lastError" = NULL
+    WHERE ${holdsClaim(id, lease)}`);
+  return changed > 0;
+}
+
+/** Retryable publication failure: stay `PENDING`, release the claim, retry after `delayMs`. */
+export async function schedulePublishRetry(
+  db: Db,
+  args: { id: string; lease: string; delayMs: number; errorClass: string; lastError: string },
+): Promise<boolean> {
+  const changed = await db.$executeRaw(Prisma.sql`
+    UPDATE "OutboxEvent" SET "publishAttemptCount" = "publishAttemptCount" + 1,
+      "errorClass" = ${args.errorClass}, "lastError" = ${args.lastError},
+      "leaseExpiresAt" = NULL, "availableAt" = ${NOW} + ${ms(args.delayMs)}
+    WHERE ${holdsClaim(args.id, args.lease)}`);
+  return changed > 0;
+}
+
+/** Non-retryable publication failure: the durable failure record. */
+export async function deadLetterUnpublished(
+  db: Db,
+  args: { id: string; lease: string; errorClass: string; lastError: string },
+): Promise<boolean> {
+  const changed = await db.$executeRaw(Prisma.sql`
+    UPDATE "OutboxEvent" SET "status" = 'DEAD_LETTER',
+      "publishAttemptCount" = "publishAttemptCount" + 1,
+      "errorClass" = ${args.errorClass}, "lastError" = ${args.lastError}, "leaseExpiresAt" = NULL
+    WHERE ${holdsClaim(args.id, args.lease)}`);
+  return changed > 0;
+}
+
+/** The worker finished the job: `PROCESSING → SUCCESS`. */
+export async function markSuccess(db: Db, id: string): Promise<boolean> {
+  const changed = await db.$executeRaw(Prisma.sql`
+    UPDATE "OutboxEvent" SET "status" = 'SUCCESS', "processedAt" = ${NOW}, "leaseExpiresAt" = NULL
+    WHERE "id" = ${id}::uuid AND "status" = 'PROCESSING'`);
+  return changed > 0;
+}
+
+/** A retryable execution failure: count it and keep the row alive until the retry is due. */
+export async function recordExecutionRetry(
+  db: Db,
+  args: {
+    id: string;
+    delayMs: number;
+    processingWindowMs: number;
+    errorClass: string;
+    lastError: string;
+  },
+): Promise<boolean> {
+  const changed = await db.$executeRaw(Prisma.sql`
+    UPDATE "OutboxEvent" SET "executionAttemptCount" = "executionAttemptCount" + 1,
+      "errorClass" = ${args.errorClass}, "lastError" = ${args.lastError},
+      "leaseExpiresAt" = ${NOW} + ${ms(args.delayMs)} + ${ms(args.processingWindowMs)}
+    WHERE "id" = ${args.id}::uuid AND "status" = 'PROCESSING'`);
+  return changed > 0;
+}
+
+export type DeadLettered = {
+  id: string;
+  eventType: string;
+  publishAttemptCount: number;
+  executionAttemptCount: number;
+};
+
+/** Terminal execution failure: `PROCESSING → DEAD_LETTER` with the failure record. */
+export async function deadLetterExecution(
+  db: Db,
+  args: { id: string; errorClass: string; lastError: string },
+): Promise<DeadLettered | null> {
+  const rows = await db.$queryRaw<DeadLettered[]>(Prisma.sql`
+    UPDATE "OutboxEvent" SET "status" = 'DEAD_LETTER',
+      "executionAttemptCount" = "executionAttemptCount" + 1,
+      "errorClass" = ${args.errorClass}, "lastError" = ${args.lastError}, "leaseExpiresAt" = NULL
+    WHERE "id" = ${args.id}::uuid AND "status" = 'PROCESSING'
+    RETURNING "id", "eventType", "publishAttemptCount", "executionAttemptCount"`);
+  return rows[0] ?? null;
+}
+
+/** `PROCESSING` rows whose deadline passed (worker or Redis lost) go back to `PENDING`. */
+export function recoverStaleProcessing(db: Db): Promise<number> {
+  return db.$executeRaw(Prisma.sql`
+    UPDATE "OutboxEvent" SET "status" = 'PENDING', "availableAt" = ${NOW}, "leaseExpiresAt" = NULL
+    WHERE "status" = 'PROCESSING' AND "leaseExpiresAt" < ${NOW}`);
+}
+
+/** Deletes finished rows older than the retention window; `DEAD_LETTER` rows are never touched. */
+export function deleteExpiredSuccess(db: Db, retentionMs: number): Promise<number> {
+  return db.$executeRaw(Prisma.sql`
+    DELETE FROM "OutboxEvent"
+    WHERE "status" = 'SUCCESS' AND "processedAt" < ${NOW} - ${ms(retentionMs)}`);
+}
diff --git a/backend/src/infra/jobs/outbox.ts b/backend/src/infra/jobs/outbox.ts
new file mode 100644
index 0000000..d09f849
--- /dev/null
+++ b/backend/src/infra/jobs/outbox.ts
@@ -0,0 +1,59 @@
+import type { Prisma } from '../../generated/prisma/client.js';
+import type { TransactionClient } from '../db/prisma.js';
+import { isOutboxEventType, validatePayload } from './events.js';
+
+export type EnqueueOutboxInput = {
+  eventType: string;
+  aggregateType: string;
+  aggregateId: string;
+  payload: unknown;
+  availableAt?: Date;
+};
+
+/** Thrown to the producer when the event or its payload is not acceptable; nothing is written. */
+export class OutboxContractError extends Error {
+  constructor(
+    readonly reason: 'UNSUPPORTED_EVENT_TYPE' | 'INVALID_PAYLOAD' | 'INVALID_AGGREGATE',
+    message: string,
+  ) {
+    super(message);
+    this.name = 'OutboxContractError';
+  }
+}
+
+const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+
+/**
+ * Writes one `PENDING` outbox row on the caller's transaction. It never commits, opens a
+ * transaction or touches Redis: the row exists exactly when the producer's change commits.
+ */
+export async function enqueueOutbox(
+  tx: TransactionClient,
+  input: EnqueueOutboxInput,
+): Promise<string> {
+  if (!isOutboxEventType(input.eventType)) {
+    throw new OutboxContractError('UNSUPPORTED_EVENT_TYPE', 'Unsupported outbox event type');
+  }
+  if (!UUID.test(input.aggregateId)) {
+    throw new OutboxContractError('INVALID_AGGREGATE', 'aggregateId must be a UUID');
+  }
+  const checked = validatePayload(input.eventType, input.payload);
+  if (!checked.ok) {
+    throw new OutboxContractError(
+      'INVALID_PAYLOAD',
+      `Invalid payload for ${input.eventType}: ${checked.fields.join(', ')}`,
+    );
+  }
+
+  const row = await tx.outboxEvent.create({
+    data: {
+      eventType: input.eventType,
+      aggregateType: input.aggregateType,
+      aggregateId: input.aggregateId,
+      payload: checked.payload as Prisma.InputJsonObject,
+      ...(input.availableAt === undefined ? {} : { availableAt: input.availableAt }),
+    },
+    select: { id: true },
+  });
+  return row.id;
+}
diff --git a/backend/src/infra/jobs/processor.ts b/backend/src/infra/jobs/processor.ts
new file mode 100644
index 0000000..a7d0132
--- /dev/null
+++ b/backend/src/infra/jobs/processor.ts
@@ -0,0 +1,172 @@
+import { UnrecoverableError, Worker, type Job } from 'bullmq';
+import type { Redis } from 'ioredis';
+import { z } from 'zod';
+import type { JobsConfig } from '../../config/env.js';
+import { logger } from '../../shared/observability/logger.js';
+import { getPrisma } from '../db/prisma.js';
+import { executionRetryDelayMs } from './backoff.js';
+import { announceDeadLetter } from './dead-letter.js';
+import { classifyError, NonRetryableJobError, sanitizeError } from './errors.js';
+import { isOutboxEventType, queueForEvent, validatePayload, type QueueName } from './events.js';
+import type { QueueGateway } from './gateway.js';
+import { deadLetterExecution, markSuccess, recordExecutionRetry } from './outbox.repository.js';
+import type { OutboxProcessor } from './registry.js';
+import { requestIdOf } from './relay.js';
+
+export type WorkerConfig = Pick<
+  JobsConfig,
+  | 'executionAttempts'
+  | 'executionBackoffBaseMs'
+  | 'executionBackoffCapMs'
+  | 'processingWindowMs'
+  | 'workerConcurrency'
+  | 'queueRateLimits'
+>;
+
+const jobDataSchema = z.object({
+  outboxEventId: z.uuid(),
+  eventType: z.string(),
+  aggregateType: z.string(),
+  aggregateId: z.string(),
+  payload: z.unknown(),
+});
+
+type JobLike = Pick<Job, 'data' | 'attemptsMade' | 'opts'>;
+
+/**
+ * The common wrapper around every consumer. On success the outbox row becomes `SUCCESS`; on failure
+ * the error is classified: retryable errors are counted and rethrown so BullMQ retries (up to the
+ * configured attempts); non-retryable errors and the last failed attempt write the `DEAD_LETTER`
+ * record first and then announce it on the `dead-letter` queue.
+ */
+export async function processOutboxJob(
+  job: JobLike,
+  queue: QueueName,
+  processor: OutboxProcessor,
+  deps: { config: WorkerConfig; gateway: QueueGateway },
+): Promise<void> {
+  const parsed = jobDataSchema.safeParse(job.data);
+  if (!parsed.success) {
+    logger.error(
+      { queue, outcome: 'unreadable_job' },
+      'Job data does not identify an outbox event',
+    );
+    throw new UnrecoverableError('Unreadable job data');
+  }
+  const data = parsed.data;
+
+  const db = getPrisma();
+  const started = Date.now();
+  const attempt = job.attemptsMade + 1;
+  const maxAttempts = job.opts.attempts ?? deps.config.executionAttempts;
+  const requestId = requestIdOf(data.payload);
+  const fields = {
+    queue,
+    jobId: data.outboxEventId,
+    outboxEventId: data.outboxEventId,
+    eventType: data.eventType,
+    attempt,
+    maxAttempts,
+    requestId,
+  };
+
+  try {
+    if (!isOutboxEventType(data.eventType) || queueForEvent(data.eventType) !== queue) {
+      throw new NonRetryableJobError('UNSUPPORTED_EVENT_TYPE', 'Unsupported event type');
+    }
+    const checked = validatePayload(data.eventType, data.payload);
+    if (!checked.ok) {
+      throw new NonRetryableJobError(
+        'INVALID_PAYLOAD',
+        `Invalid payload fields: ${checked.fields.join(', ')}`,
+      );
+    }
+
+    await processor({
+      outboxEventId: data.outboxEventId,
+      eventType: data.eventType,
+      aggregateType: data.aggregateType,
+      aggregateId: data.aggregateId,
+      payload: checked.payload,
+      attempt,
+    });
+    const marked = await markSuccess(db, data.outboxEventId);
+    logger.info(
+      {
+        ...fields,
+        outcome: marked ? 'success' : 'success_row_not_processing',
+        durationMs: Date.now() - started,
+      },
+      'Job completed',
+    );
+  } catch (error) {
+    const { retryable, errorClass } = classifyError(error);
+    const lastError = sanitizeError(error);
+    const durationMs = Date.now() - started;
+
+    if (!retryable || attempt >= maxAttempts) {
+      const record = await deadLetterExecution(db, {
+        id: data.outboxEventId,
+        errorClass,
+        lastError,
+      });
+      logger.error(
+        { ...fields, errorClass, retryable, outcome: 'dead_letter', durationMs },
+        'Job dead-lettered',
+      );
+      if (record) {
+        await announceDeadLetter(deps.gateway, {
+          outboxEventId: data.outboxEventId,
+          eventType: data.eventType,
+          sourceQueue: queue,
+          errorClass,
+          requestId,
+        });
+      }
+      throw new UnrecoverableError(lastError);
+    }
+
+    const delayMs = executionRetryDelayMs(attempt, error, deps.config);
+    await recordExecutionRetry(db, {
+      id: data.outboxEventId,
+      delayMs,
+      processingWindowMs: deps.config.processingWindowMs,
+      errorClass,
+      lastError,
+    });
+    logger.warn(
+      {
+        ...fields,
+        errorClass,
+        retryable,
+        retryInMs: delayMs,
+        outcome: 'retry_scheduled',
+        durationMs,
+      },
+      'Job failed; will retry',
+    );
+    throw error;
+  }
+}
+
+/** One BullMQ worker for `queue`, running the common wrapper around `processor`. */
+export function createJobWorker(
+  queue: QueueName,
+  processor: OutboxProcessor,
+  deps: { config: WorkerConfig; gateway: QueueGateway },
+  connection: Redis,
+): Worker {
+  const limit = deps.config.queueRateLimits[queue];
+  const worker = new Worker(queue, (job) => processOutboxJob(job, queue, processor, deps), {
+    connection,
+    concurrency: deps.config.workerConcurrency,
+    limiter: { max: limit.max, duration: limit.durationMs },
+    settings: {
+      backoffStrategy: (attemptsMade, _type, error) =>
+        executionRetryDelayMs(attemptsMade, error, deps.config),
+    },
+  });
+  worker.on('error', (err) => logger.warn({ err, queue }, 'Worker error'));
+  worker.on('stalled', (jobId) => logger.warn({ queue, jobId, outcome: 'stalled' }, 'Job stalled'));
+  return worker;
+}
