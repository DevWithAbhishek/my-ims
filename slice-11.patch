+import { parseOrThrow } from '../../../shared/errors/zod.js';
+import { createPostmortemBodySchema } from './postmortem.schema.js';
+
+const valid = {
+  summary: 's',
+  impact: 'i',
+  detection: 'd',
+  timeline: 't',
+  rootCause: 'r',
+  contributingFactors: 'c',
+  resolution: 'x',
+  correctiveActions: 'a',
+  preventiveActions: 'p',
+  riskLevel: 'P2',
+};
+
+describe('CreatePostmortemDto', () => {
+  it('accepts the whole content without unknowns, with null and with a string', () => {
+    expect(parseOrThrow(createPostmortemBodySchema, valid).unknowns).toBeUndefined();
+    expect(
+      parseOrThrow(createPostmortemBodySchema, { ...valid, unknowns: null }).unknowns,
+    ).toBeNull();
+    expect(parseOrThrow(createPostmortemBodySchema, { ...valid, unknowns: 'u' }).unknowns).toBe(
+      'u',
+    );
+  });
+
+  it.each(Object.keys(valid))('requires %s (422)', (field) => {
+    const body: Record<string, unknown> = { ...valid };
+    delete body[field];
+    expect(() => parseOrThrow(createPostmortemBodySchema, body)).toThrow(
+      expect.objectContaining({ statusCode: 422 }),
+    );
+  });
+
+  it('rejects unknown fields with 400, and a bad riskLevel or an over-long text with 422', () => {
+    expect(() => parseOrThrow(createPostmortemBodySchema, { ...valid, mttrMinutes: 1 })).toThrow(
+      expect.objectContaining({ statusCode: 400 }),
+    );
+    expect(() => parseOrThrow(createPostmortemBodySchema, { ...valid, riskLevel: 'P9' })).toThrow(
+      expect.objectContaining({ statusCode: 422 }),
+    );
+    expect(() =>
+      parseOrThrow(createPostmortemBodySchema, { ...valid, summary: 'x'.repeat(20_001) }),
+    ).toThrow(expect.objectContaining({ statusCode: 422 }));
+  });
+});
diff --git a/backend/src/modules/incidents/postmortem/postmortem.schema.ts b/backend/src/modules/incidents/postmortem/postmortem.schema.ts
new file mode 100644
index 0000000..a6e229c
--- /dev/null
+++ b/backend/src/modules/incidents/postmortem/postmortem.schema.ts
@@ -0,0 +1,52 @@
+import { z } from 'zod';
+
+/** Bound of every postmortem text field (SLICE-11 §4.4, §4.5). */
+export const POSTMORTEM_TEXT_MAX = 20_000;
+
+/** Trimmed, non-empty, bounded; `trim()` runs first so a blank string is empty and rejected. */
+const text = z.string().trim().min(1).max(POSTMORTEM_TEXT_MAX);
+const riskLevel = z.enum(['P0', 'P1', 'P2', 'P3']);
+
+/**
+ * `UpdatePostmortemDto`: every field optional; which action it is (P2, P3, P4) follows from the
+ * fields present (see `postmortem.dispatcher.ts`). `mttrMinutes`, `provenance` and `review` are
+ * not editable, so they are unknown fields (`400`).
+ */
+export const updatePostmortemBodySchema = z
+  .object({
+    summary: text.optional(),
+    impact: text.optional(),
+    detection: text.optional(),
+    timeline: text.optional(),
+    rootCause: text.optional(),
+    contributingFactors: text.optional(),
+    resolution: text.optional(),
+    correctiveActions: text.optional(),
+    preventiveActions: text.optional(),
+    unknowns: text.nullable().optional(),
+    riskLevel: riskLevel.optional(),
+    reviewStatus: z.literal('REVIEWED').optional(),
+    generationStatus: z.literal('GENERATING').optional(),
+  })
+  .strict();
+
+export type UpdatePostmortemBody = z.output<typeof updatePostmortemBodySchema>;
+
+/** `CreatePostmortemDto` (P5): the whole content is required, `unknowns` may be absent or `null`. */
+export const createPostmortemBodySchema = z
+  .object({
+    summary: text,
+    impact: text,
+    detection: text,
+    timeline: text,
+    rootCause: text,
+    contributingFactors: text,
+    resolution: text,
+    correctiveActions: text,
+    preventiveActions: text,
+    unknowns: text.nullable().optional(),
+    riskLevel,
+  })
+  .strict();
+
+export type CreatePostmortemBody = z.output<typeof createPostmortemBodySchema>;
diff --git a/backend/src/modules/incidents/postmortem/postmortem.service.ts b/backend/src/modules/incidents/postmortem/postmortem.service.ts
new file mode 100644
index 0000000..400f83e
--- /dev/null
+++ b/backend/src/modules/incidents/postmortem/postmortem.service.ts
@@ -0,0 +1,164 @@
+import { getPrisma } from '../../../infra/db/prisma.js';
+import type { AuthContext } from '../../../shared/types/auth-context.js';
+import { getEscalationPolicyByService } from '../../appService/index.js';
+import { requireTeam } from '../../identity/index.js';
+import { findIncidentScope } from '../incident.repository.js';
+import { assertIncidentAccess, withDatabaseOutageMapping, type Db } from '../incidents.common.js';
+import { assertChainMember } from '../lifecycle/lifecycle.rules.js';
+import { NO_CHANGE } from '../lifecycle/lifecycle.types.js';
+import { runTransition } from '../lifecycle/transition.kernel.js';
+import { toPostmortemResponse } from './postmortem.mapper.js';
+import { planClosure } from './postmortem.plans.js';
+import {
+  findIncidentTimes,
+  findPostmortemRow,
+  lockPostmortemForUpdate,
+  markPostmortemGenerating,
+  markPostmortemReviewed,
+  populateManualPostmortem,
+  updatePostmortemContent,
+} from './postmortem.repository.js';
+import {
+  assertManuallyCreatable,
+  assertRetryable,
+  assertReviewable,
+  computeMttrMinutes,
+  postmortemNotFound,
+} from './postmortem.rules.js';
+import type { CreatePostmortemBody } from './postmortem.schema.js';
+import type { PostmortemContentUpdate, PostmortemResponse } from './postmortem.types.js';
+
+async function respondWith(tx: Db, incidentId: string): Promise<PostmortemResponse> {
+  const row = await findPostmortemRow(tx, incidentId);
+  if (row === null) throw postmortemNotFound();
+  return toPostmortemResponse(row);
+}
+
+/** Gate 2 beyond the team gate: the caller must be one of the four users of the service's policy. */
+const chainGate = (auth: AuthContext) => async (scope: { affectedServiceId: string }) =>
+  assertChainMember(await getEscalationPolicyByService(scope.affectedServiceId), auth.userId);
+
+/** P1: the incident's postmortem. Any role of the incident's team. */
+export async function getPostmortem(
+  auth: AuthContext,
+  incidentId: string,
+): Promise<PostmortemResponse> {
+  requireTeam(auth);
+  return withDatabaseOutageMapping(async () => {
+    const db = getPrisma();
+    assertIncidentAccess(auth, await findIncidentScope(db, incidentId));
+    const row = await findPostmortemRow(db, incidentId);
+    if (row === null) throw postmortemNotFound();
+    return toPostmortemResponse(row);
+  });
+}
+
+/**
+ * P2 edit. Under the incident and postmortem locks the state is re-checked and only the sent
+ * fields are written; the review fields stay as they are and no event or notification is written.
+ */
+export function editPostmortem(
+  auth: AuthContext,
+  incidentId: string,
+  fields: PostmortemContentUpdate,
+  requestId: string,
+) {
+  return runTransition({
+    auth,
+    incidentId,
+    requestId,
+    decide: async (tx, incident) => {
+      const postmortem = await lockPostmortemForUpdate(tx, incidentId);
+      assertReviewable(postmortem, incident.status);
+      await updatePostmortemContent(tx, postmortem.id, fields);
+      return NO_CHANGE;
+    },
+    respond: (tx) => respondWith(tx, incidentId),
+  });
+}
+
+/**
+ * P3 approve. Chain members only. One transaction: the review, the closure of the incident, both
+ * audit events in order and both notifications.
+ */
+export function approvePostmortem(auth: AuthContext, incidentId: string, requestId: string) {
+  return runTransition({
+    auth,
+    incidentId,
+    requestId,
+    gate: chainGate(auth),
+    decide: async (tx, incident) => {
+      const postmortem = await lockPostmortemForUpdate(tx, incidentId);
+      assertReviewable(postmortem, incident.status);
+      const now = new Date();
+      await markPostmortemReviewed(tx, postmortem.id, auth.userId, now);
+      return planClosure(postmortem.id, auth.userId, now);
+    },
+    respond: (tx) => respondWith(tx, incidentId),
+  });
+}
+
+/** P4 retry. Back to `GENERATING` and a new generation request in the outbox, in one transaction. */
+export function retryPostmortemGeneration(
+  auth: AuthContext,
+  incidentId: string,
+  requestId: string,
+) {
+  return runTransition({
+    auth,
+    incidentId,
+    requestId,
+    decide: async (tx, incident) => {
+      const postmortem = await lockPostmortemForUpdate(tx, incidentId);
+      assertRetryable(postmortem, incident.status);
+      await markPostmortemGenerating(tx, postmortem.id);
+      return {
+        changes: {},
+        events: [],
+        outbox: [
+          {
+            eventType: 'POSTMORTEM_GENERATION_REQUESTED' as const,
+            aggregateType: 'POSTMORTEM',
+            aggregateId: postmortem.id,
+            payload: { postmortemId: postmortem.id, incidentId },
+          },
+        ],
+      };
+    },
+    respond: (tx) => respondWith(tx, incidentId),
+  });
+}
+
+/**
+ * P5 manual create. Chain members only. The `FAILED` row is reused and populated, and the incident
+ * is closed with the same two events and notifications as P3, in one transaction.
+ */
+export function createManualPostmortem(
+  auth: AuthContext,
+  incidentId: string,
+  content: CreatePostmortemBody,
+  requestId: string,
+) {
+  return runTransition({
+    auth,
+    incidentId,
+    requestId,
+    gate: chainGate(auth),
+    decide: async (tx, incident) => {
+      const postmortem = await lockPostmortemForUpdate(tx, incidentId);
+      assertManuallyCreatable(postmortem, incident.status);
+      const times = await findIncidentTimes(tx, incidentId);
+      const now = new Date();
+      await populateManualPostmortem(
+        tx,
+        postmortem.id,
+        content,
+        computeMttrMinutes(times.createdAt, times.resolvedAt),
+        auth.userId,
+        now,
+      );
+      return planClosure(postmortem.id, auth.userId, now);
+    },
+    respond: (tx) => respondWith(tx, incidentId),
+  });
+}
