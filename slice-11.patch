index 0000000..e152819
--- /dev/null
+++ b/backend/src/modules/incidents/postmortem/postmortem.plans.ts
@@ -0,0 +1,20 @@
+import type { Plan } from '../lifecycle/lifecycle.types.js';
+
+/**
+ * The `RESOLVED → CLOSED` transition shared by P3 and P5: the incident is closed by the caller,
+ * and the two audit events are written in this order, `POSTMORTEM_REVIEWED` then `CLOSED`. The
+ * kernel adds one notification per event.
+ */
+export function planClosure(postmortemId: string, reviewerId: string, now: Date): Plan {
+  return {
+    changes: { status: 'CLOSED', closedById: reviewerId, closedTimestamp: now },
+    events: [
+      {
+        eventType: 'POSTMORTEM_REVIEWED',
+        metadata: { postmortemId, reviewedBy: reviewerId },
+      },
+      { eventType: 'CLOSED', metadata: { closedAt: now.toISOString() } },
+    ],
+    outbox: [],
+  };
+}
diff --git a/backend/src/modules/incidents/postmortem/postmortem.repository.ts b/backend/src/modules/incidents/postmortem/postmortem.repository.ts
new file mode 100644
index 0000000..61a2d27
--- /dev/null
+++ b/backend/src/modules/incidents/postmortem/postmortem.repository.ts
@@ -0,0 +1,153 @@
+import { Prisma } from '../../../generated/prisma/client.js';
+import type { Db } from '../incidents.common.js';
+import type {
+  LockedPostmortem,
+  PostmortemContentUpdate,
+  PostmortemGenerationStatus,
+  PostmortemReviewStatus,
+} from './postmortem.types.js';
+import type { CreatePostmortemBody } from './postmortem.schema.js';
+
+/** The columns exposed by `PostmortemResponse`; `prompt` and `inputData` are never selected. */
+const RESPONSE_SELECT = {
+  id: true,
+  incidentId: true,
+  generationStatus: true,
+  reviewStatus: true,
+  summary: true,
+  impact: true,
+  detection: true,
+  timeline: true,
+  rootCause: true,
+  factors: true,
+  resolution: true,
+  correctiveActions: true,
+  preventiveActions: true,
+  unknowns: true,
+  MTTR: true,
+  riskLevel: true,
+  model: true,
+  modelVersion: true,
+  generatedAt: true,
+  reviewedAt: true,
+  failureReason: true,
+  reviewedBy: { select: { id: true, name: true } },
+} satisfies Prisma.PostmortemSelect;
+
+export type PostmortemRow = Prisma.PostmortemGetPayload<{ select: typeof RESPONSE_SELECT }>;
+
+/** The incident's postmortem (at most one: `incidentId` is unique), or `null`. */
+export function findPostmortemRow(db: Db, incidentId: string): Promise<PostmortemRow | null> {
+  return db.postmortem.findUnique({ where: { incidentId }, select: RESPONSE_SELECT });
+}
+
+/**
+ * `SELECT … FOR UPDATE` on the incident's postmortem row. Always taken after the incident row
+ * lock, so every writer locks in the same order. `null` when the incident has no postmortem.
+ */
+export async function lockPostmortemForUpdate(
+  db: Db,
+  incidentId: string,
+): Promise<LockedPostmortem | null> {
+  const rows = await db.$queryRaw<
+    {
+      id: string;
+      generationStatus: PostmortemGenerationStatus;
+      reviewStatus: PostmortemReviewStatus;
+    }[]
+  >(Prisma.sql`
+    SELECT "id", "generationStatus"::text AS "generationStatus", "reviewStatus"::text AS "reviewStatus"
+    FROM "Postmortem" WHERE "incidentId" = ${incidentId}::uuid FOR UPDATE`);
+  return rows[0] ?? null;
+}
+
+/** What the MTTR needs, read under the incident lock. `resolvedAt` is set once `RESOLVED`. */
+export async function findIncidentTimes(
+  db: Db,
+  incidentId: string,
+): Promise<{ createdAt: Date; resolvedAt: Date }> {
+  const row = await db.incident.findUniqueOrThrow({
+    where: { id: incidentId },
+    select: { createdAt: true, resolvedTimestamp: true },
+  });
+  if (row.resolvedTimestamp === null) {
+    throw new Error('A resolved incident has no resolvedTimestamp');
+  }
+  return { createdAt: row.createdAt, resolvedAt: row.resolvedTimestamp };
+}
+
+/** P2: only the sent fields change (`contributingFactors` is the column `factors`). */
+export async function updatePostmortemContent(
+  db: Db,
+  postmortemId: string,
+  fields: PostmortemContentUpdate,
+): Promise<void> {
+  const { contributingFactors, ...rest } = fields;
+  await db.postmortem.update({
+    where: { id: postmortemId },
+    data: { ...rest, factors: contributingFactors, updatedAt: new Date() },
+  });
+}
+
+/** P3: the review. The closure of the incident is written by the transition kernel. */
+export async function markPostmortemReviewed(
+  db: Db,
+  postmortemId: string,
+  reviewerId: string,
+  now: Date,
+): Promise<void> {
+  await db.postmortem.update({
+    where: { id: postmortemId },
+    data: { reviewStatus: 'REVIEWED', reviewedById: reviewerId, reviewedAt: now, updatedAt: now },
+  });
+}
+
+/** P4: back to `GENERATING` with the failure reason cleared. */
+export async function markPostmortemGenerating(db: Db, postmortemId: string): Promise<void> {
+  await db.postmortem.update({
+    where: { id: postmortemId },
+    data: { generationStatus: 'GENERATING', failureReason: null, updatedAt: new Date() },
+  });
+}
+
+/**
+ * P5: the `FAILED` row is reused and populated; the failure reason and every provenance column
+ * are cleared, and the postmortem is a reviewed draft.
+ */
+export async function populateManualPostmortem(
+  db: Db,
+  postmortemId: string,
+  content: CreatePostmortemBody,
+  mttrMinutes: number,
+  reviewerId: string,
+  now: Date,
+): Promise<void> {
+  await db.postmortem.update({
+    where: { id: postmortemId },
+    data: {
+      summary: content.summary,
+      impact: content.impact,
+      detection: content.detection,
+      timeline: content.timeline,
+      rootCause: content.rootCause,
+      factors: content.contributingFactors,
+      resolution: content.resolution,
+      correctiveActions: content.correctiveActions,
+      preventiveActions: content.preventiveActions,
+      unknowns: content.unknowns ?? null,
+      riskLevel: content.riskLevel,
+      MTTR: mttrMinutes,
+      failureReason: null,
+      model: null,
+      modelVersion: null,
+      prompt: null,
+      inputData: null,
+      generatedAt: null,
+      generationStatus: 'DRAFT',
+      reviewStatus: 'REVIEWED',
+      reviewedById: reviewerId,
+      reviewedAt: now,
+      updatedAt: now,
+    },
+  });
+}
diff --git a/backend/src/modules/incidents/postmortem/postmortem.rules.spec.ts b/backend/src/modules/incidents/postmortem/postmortem.rules.spec.ts
new file mode 100644
index 0000000..57d07e9
--- /dev/null
+++ b/backend/src/modules/incidents/postmortem/postmortem.rules.spec.ts
@@ -0,0 +1,136 @@
+import { AppError } from '../../../shared/errors/AppError.js';
+import type { IncidentStatus } from '../incidents.types.js';
+import {
+  assertManuallyCreatable,
+  assertRetryable,
+  assertReviewable,
+  computeMttrMinutes,
+  deriveAiGenerated,
+} from './postmortem.rules.js';
+import type {
+  LockedPostmortem,
+  PostmortemGenerationStatus,
+  PostmortemReviewStatus,
+} from './postmortem.types.js';
+
+const pm = (
+  generationStatus: PostmortemGenerationStatus,
+  reviewStatus: PostmortemReviewStatus = 'PENDING',
+): LockedPostmortem => ({ id: 'p', generationStatus, reviewStatus });
+
+const outcome = (run: () => void): string => {
+  try {
+    run();
+    return 'ok';
+  } catch (error) {
+    const e = error as AppError;
+    return `${e.statusCode} ${e.code}`;
+  }
+};
+
+describe('assertReviewable (P2, P3)', () => {
+  it('passes for an unreviewed draft of a RESOLVED incident', () => {
+    expect(outcome(() => assertReviewable(pm('DRAFT'), 'RESOLVED'))).toBe('ok');
+  });
+
+  it('is 404 POSTMORTEM_NOT_FOUND without a postmortem', () => {
+    expect(outcome(() => assertReviewable(null, 'MITIGATING'))).toBe('404 POSTMORTEM_NOT_FOUND');
+  });
+
+  it.each([
+    [pm('GENERATING'), 'RESOLVED'],
+    [pm('FAILED'), 'RESOLVED'],
+    [pm('DRAFT', 'REVIEWED'), 'CLOSED'],
+    [pm('DRAFT', 'REVIEWED'), 'RESOLVED'],
+    [pm('DRAFT', 'REJECTED'), 'RESOLVED'],
+  ] as [LockedPostmortem, IncidentStatus][])(
+    'is 409 POSTMORTEM_STATE_INVALID for %j on a %s incident (a second approve included)',
+    (postmortem, status) => {
+      expect(outcome(() => assertReviewable(postmortem, status))).toBe(
+        '409 POSTMORTEM_STATE_INVALID',
+      );
+    },
+  );
+
+  it('is 403 INVALID_ACTION for an unreviewed draft of an incident that is not RESOLVED', () => {
+    expect(outcome(() => assertReviewable(pm('DRAFT'), 'CLOSED'))).toBe('403 INVALID_ACTION');
+  });
+
+  it('puts the current statuses in the 409 details', () => {
+    try {
+      assertReviewable(pm('FAILED', 'PENDING'), 'RESOLVED');
+    } catch (error) {
+      expect((error as AppError).details).toEqual([
+        { currentGenerationStatus: 'FAILED', currentReviewStatus: 'PENDING' },
+      ]);
+    }
+  });
+});
+
+describe('assertRetryable (P4)', () => {
+  it('passes for a FAILED postmortem of a RESOLVED incident', () => {
+    expect(outcome(() => assertRetryable(pm('FAILED'), 'RESOLVED'))).toBe('ok');
+  });
+
+  it('is 404 without a postmortem', () => {
+    expect(outcome(() => assertRetryable(null, 'OPEN'))).toBe('404 POSTMORTEM_NOT_FOUND');
+  });
+
+  it.each([
+    [pm('GENERATING'), 'RESOLVED'],
+    [pm('DRAFT'), 'RESOLVED'],
+    [pm('DRAFT', 'REVIEWED'), 'CLOSED'],
+    [pm('FAILED'), 'CLOSED'],
+  ] as [LockedPostmortem, IncidentStatus][])('is 403 INVALID_ACTION for %j on %s', (p, s) => {
+    expect(outcome(() => assertRetryable(p, s))).toBe('403 INVALID_ACTION');
+  });
+});
+
+describe('assertManuallyCreatable (P5)', () => {
+  it('passes for a FAILED postmortem of a RESOLVED incident', () => {
+    expect(outcome(() => assertManuallyCreatable(pm('FAILED'), 'RESOLVED'))).toBe('ok');
+  });
+
+  it.each([
+    [null, 'RESOLVED'],
+    [null, 'OPEN'],
+    [pm('GENERATING'), 'RESOLVED'],
+    [pm('DRAFT'), 'RESOLVED'],
+    [pm('DRAFT', 'REVIEWED'), 'CLOSED'],
+    [pm('FAILED'), 'CLOSED'],
+  ] as [LockedPostmortem | null, IncidentStatus][])(
+    'is 403 INVALID_ACTION for %j on %s',
+    (p, s) => {
+      expect(outcome(() => assertManuallyCreatable(p, s))).toBe('403 INVALID_ACTION');
+    },
+  );
+});
+
+describe('computeMttrMinutes', () => {
+  const created = new Date('2026-10-17T10:00:00.000Z');
+  const after = (ms: number) => new Date(created.getTime() + ms);
+
+  it.each([
+    [0, 0],
+    [1, 1],
+    [59_999, 1],
+    [60_000, 1],
+    [60_001, 2],
+    [90 * 60_000, 90],
+    [90 * 60_000 + 1, 91],
+  ])('%d ms is %d minutes (ceiling)', (ms, minutes) => {
+    expect(computeMttrMinutes(created, after(ms))).toBe(minutes);
+  });
+});
+
+describe('deriveAiGenerated', () => {
+  const generatedAt = new Date();
+  it.each([
+    ['GENERATING', null, true],
+    ['FAILED', null, true],
+    ['DRAFT', generatedAt, true],
+    ['DRAFT', null, false],
+  ] as const)('%s with generatedAt %s is %s', (generationStatus, at, expected) => {
+    expect(deriveAiGenerated({ generationStatus, generatedAt: at })).toBe(expected);
+  });
+});
diff --git a/backend/src/modules/incidents/postmortem/postmortem.rules.ts b/backend/src/modules/incidents/postmortem/postmortem.rules.ts
